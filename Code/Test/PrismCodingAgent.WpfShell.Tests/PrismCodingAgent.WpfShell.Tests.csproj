    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <VSTestLogger>trx</VSTestLogger>
