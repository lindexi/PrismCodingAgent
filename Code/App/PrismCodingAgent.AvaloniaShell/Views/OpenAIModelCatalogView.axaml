<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.OpenAIModelCatalogView"
             x:DataType="vm:ModelCatalogViewModel" x:CompileBindings="True">
    <StackPanel x:Name="CatalogPanel" x:DataType="vm:ModelCatalogViewModel" Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding SetupModelsLabel, Source={x:Static localizations:Lang.Current}}"
                       Classes="SectionTitle" VerticalAlignment="Center" />
            <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                        Content="{Binding SetupDiscoverAction, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding LoadCommand}" />
        </Grid>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
        <ScrollViewer MaxHeight="200" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Models}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <arc:Button Grid.Column="1" Variant="Ghost" Size="Small"
                                        Content="{Binding SetupAddModel, Source={x:Static localizations:Lang.Current}}"
                                        Command="{Binding $parent[ItemsControl].((vm:ModelCatalogViewModel)DataContext).AddCommand}"
                                        CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="{Binding SetupManualHint, Source={x:Static localizations:Lang.Current}}"
                   Classes="Hint" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <arc:Input Size="Small" Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                       Placeholder="{Binding SetupModelIdText, Source={x:Static localizations:Lang.Current}}" />
            <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                        Content="{Binding SetupAddModel, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding AddManualCommand}" />
        </Grid>
        <TextBlock x:Name="CatalogStatus" Text="{Binding Status}" TextWrapping="Wrap" Classes="Hint" />
    </StackPanel>
</UserControl>
