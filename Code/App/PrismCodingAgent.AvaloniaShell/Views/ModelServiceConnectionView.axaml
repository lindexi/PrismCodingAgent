<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             xmlns:views="using:PrismCodingAgent.AvaloniaShell.Views"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.ModelServiceConnectionView"
             x:DataType="vm:ProviderSettingsViewModel">
    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding SetupEndpointText, Source={x:Static localizations:Lang.Current}}"
                       Classes="FieldLabel" />
            <arc:Input Size="Small" Text="{Binding EndPoint, UpdateSourceTrigger=PropertyChanged}"
                       Placeholder="https://api.openai.com/v1" />
            <TextBlock Text="{Binding SetupEndpointHint, Source={x:Static localizations:Lang.Current}}"
                       Classes="Hint" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding SetupKeyText, Source={x:Static localizations:Lang.Current}}"
                       Classes="FieldLabel" />
            <views:SecretInput Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="{Binding SetupKeyHint, Source={x:Static localizations:Lang.Current}}"
                       Classes="Hint" />
        </StackPanel>
    </Grid>
</UserControl>
