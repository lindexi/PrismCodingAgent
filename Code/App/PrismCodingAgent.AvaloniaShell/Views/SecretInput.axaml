<TextBox xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
         xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
         x:Class="PrismCodingAgent.AvaloniaShell.Views.SecretInput"
         x:Name="SecretField"
         PasswordChar="●" VerticalContentAlignment="Center"
         MinHeight="36" Padding="12,6,0,6" FontSize="13"
         Background="{arc:ArcDesignTokenResource Surface}"
         Foreground="{arc:ArcDesignTokenResource Foreground}"
         BorderBrush="{arc:ArcDesignTokenResource Border}"
         CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
    <TextBox.InnerRightContent>
        <ToggleButton x:Name="RevealButton" Focusable="False"
                      IsChecked="{Binding #SecretField.RevealPassword, Mode=TwoWay}"
                      Width="34" Padding="7" Margin="0"
                      VerticalAlignment="Center" VerticalContentAlignment="Center"
                      CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                      Background="Transparent" BorderThickness="0">
            <ToggleButton.Styles>
                <Style Selector="ToggleButton">
                    <Setter Property="ToolTip.Tip" Value="{Binding SetupRevealKeyText, Source={x:Static localizations:Lang.Current}}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding SetupRevealKeyText, Source={x:Static localizations:Lang.Current}}" />
                </Style>
                <Style Selector="ToggleButton:checked">
                    <Setter Property="ToolTip.Tip" Value="{Binding SetupHideKeyText, Source={x:Static localizations:Lang.Current}}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding SetupHideKeyText, Source={x:Static localizations:Lang.Current}}" />
                </Style>
            </ToggleButton.Styles>
            <arc:ArcGlyph Size="17" Data="{x:Static arc:ArcIcons.Eye}"
                          Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </ToggleButton>
    </TextBox.InnerRightContent>
</TextBox>
