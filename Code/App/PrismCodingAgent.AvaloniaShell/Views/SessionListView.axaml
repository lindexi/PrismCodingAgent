<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:views="using:PrismCodingAgent.AvaloniaShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             xmlns:views11="clr-namespace:PrismCodingAgent.AvaloniaShell.Views"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.SessionListView"
             x:DataType="vm:SessionListViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,0,16,16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{Binding SessionListTitle, Source={x:Static localizations:Lang.Current}}" Classes="PageTitle" />
            <arc:Button Grid.Column="1" Variant="Secondary" Size="Small" VerticalAlignment="Center"
                        Content="{Binding RefreshHistoryText, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding ReloadCommand}" />
        </Grid>

        <arc:Input Grid.Row="1" Size="Small" Margin="0,0,0,12"
                   Placeholder="{Binding HistorySearchText, Source={x:Static localizations:Lang.Current}}"
                   Text="{Binding SearchText}">
            <arc:Input.Prefix>
                <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Search}" Opacity="0.7" />
            </arc:Input.Prefix>
        </arc:Input>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="{Binding HistoryLoadingText, Source={x:Static localizations:Lang.Current}}"
                       Classes="Caption" IsVisible="{Binding IsLoading}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource Danger}" />
        </StackPanel>

        <Grid Grid.Row="3">
            <arc:EmptyState IsVisible="{Binding IsEmpty}"
                            Title="{Binding EmptySessionListText, Source={x:Static localizations:Lang.Current}}"
                            Icon="{x:Static arc:ArcIcons.Clock3}" />

            <ListBox ItemsSource="{Binding Sessions}" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                        <Border Padding="16,12" Margin="0,4"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                DoubleTapped="OnSessionDoubleTapped">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsEditing}" ToolTip.Tip="{Binding Title}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsEditing}">
                                        <arc:Input Text="{Binding EditedTitle}" Size="Small"
                                                   HorizontalAlignment="Stretch" />
                                        <arc:Button Grid.Column="1" Margin="8,0,0,0" Variant="Primary" Size="Small"
                                                    Content="{Binding SaveTitleText, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[UserControl].DataContext.SaveTitleCommand}"
                                                    CommandParameter="{Binding}" />
                                        <arc:Button Grid.Column="2" Margin="8,0,0,0" Variant="Ghost" Size="Small"
                                                    Content="{Binding CancelEditText, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[UserControl].DataContext.CancelEditCommand}"
                                                    CommandParameter="{Binding}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                Margin="12,0,0,0" IsVisible="{Binding !IsEditing}">
                                        <Border IsVisible="{Binding IsCurrent}" Padding="10,4"
                                                VerticalAlignment="Center"
                                                Background="{arc:ArcDesignTokenResource AccentSubtle}"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}">
                                            <TextBlock Text="{Binding CurrentSessionText, Source={x:Static localizations:Lang.Current}}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource Accent}" />
                                        </Border>
                                        <arc:Button Variant="Ghost" Size="Small"
                                                    ToolTip.Tip="{Binding EditSessionTitleText, Source={x:Static localizations:Lang.Current}}"
                                                    AutomationProperties.Name="{Binding EditSessionTitleText, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[UserControl].DataContext.EditTitleCommand}"
                                                    CommandParameter="{Binding}">
                                            <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Pencil}" />
                                        </arc:Button>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="Caption" TextTrimming="CharacterEllipsis">
                                            <ToolTip.Tip>
                                                <TextBlock><Run Text="{Binding WorkTaskText}" /><Run Text=" | " /><Run Text="{Binding Subtitle}" /></TextBlock>
                                            </ToolTip.Tip>
                                            <Run Text="{Binding WorkTaskText}" /><Run Text=" | " /><Run Text="{Binding Subtitle}" />
                                        </TextBlock>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="{Binding SessionWorkspaceText, Source={x:Static localizations:Lang.Current}}"
                                                       Classes="Caption" />
                                            <TextBlock Grid.Column="1" Text="{Binding WorkspacePath}" Classes="Caption"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkspacePath}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                        <arc:Button Variant="Secondary" Size="Small"
                                                    Content="{Binding OpenSessionText, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[views11:MainView].((vm:MainViewModel)DataContext).OpenSessionCommand}"
                                                    CommandParameter="{Binding}" />
                                        <arc:Button Variant="Ghost" Size="Small"
                                                    ToolTip.Tip="{Binding DeleteSessionText, Source={x:Static localizations:Lang.Current}}"
                                                    AutomationProperties.Name="{Binding DeleteSessionText, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[UserControl].DataContext.DeleteSessionCommand}"
                                                    CommandParameter="{Binding}">
                                            <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Trash2}"
                                                          Foreground="{arc:ArcDesignTokenResource Danger}" />
                                        </arc:Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
