<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:model="using:AgentLib.Model"
             xmlns:views="using:PrismCodingAgent.AvaloniaShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.ChatView"
             x:DataType="vm:ChatViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="model:CopilotChatTextItem" x:DataType="model:CopilotChatTextItem">
            <arc:Markdown Margin="0,0,0,6" FontSize="14" BlockSpacing="10"
                          IsVisible="{Binding HasText}"
                          Text="{Binding Text}" />
        </DataTemplate>

        <DataTemplate DataType="model:CopilotChatImageItem" x:DataType="model:CopilotChatImageItem">
            <arc:Button Margin="0,0,0,8" Variant="Ghost" Padding="4"
                        HorizontalAlignment="Left"
                        ToolTip.Tip="{Binding OpenImageExternallyText, Source={x:Static localizations:Lang.Current}}"
                        CommandParameter="{Binding}" Click="ImageButton_OnClick">
                <views:BinaryImage Width="240" Height="180" Data="{Binding Data}" />
            </arc:Button>
        </DataTemplate>

        <DataTemplate DataType="model:CopilotChatReasoningItem" x:DataType="model:CopilotChatReasoningItem">
            <arc:ExpandableCard Margin="0,0,0,8" IsExpanded="False" IsVisible="{Binding HasText}"
                                Header="{Binding ReasoningProcess, Source={x:Static localizations:Lang.Current}}">
                <arc:Markdown FontSize="13" Text="{Binding Text}" />
            </arc:ExpandableCard>
        </DataTemplate>

        <DataTemplate DataType="model:CopilotChatApprovalToolItem" x:DataType="model:CopilotChatApprovalToolItem">
            <arc:ToolCall Margin="0,0,0,8"
                          Item="{Binding Converter={StaticResource ToolCallProjection}}"
                          ApproveRequested="OnToolCallApproveRequested"
                          DenyRequested="OnToolCallDenyRequested" />
        </DataTemplate>

        <DataTemplate DataType="model:CopilotChatToolItem" x:DataType="model:CopilotChatToolItem">
            <StackPanel Margin="0,0,0,8" Spacing="4">
                <arc:ToolCall Item="{Binding Converter={StaticResource ToolCallProjection}}" />
                <ItemsControl ItemsSource="{Binding Details.MessageItems}" Margin="26,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="model:CopilotChatSubAgentItem" x:DataType="model:CopilotChatSubAgentItem">
            <arc:ExpandableCard Margin="0,0,0,8" IsExpanded="True" Header="{Binding DisplayName}">
                <StackPanel Spacing="6">
                    <arc:Markdown FontSize="13" IsVisible="{Binding HasInputText}" Text="{Binding InputText}" />
                    <ItemsControl ItemsSource="{Binding MessageItems}" IsVisible="{Binding HasMessageItems}" />
                    <arc:Markdown FontSize="13" IsVisible="{Binding HasOutputText}" Text="{Binding OutputText}" />
                </StackPanel>
            </arc:ExpandableCard>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,*,Auto" Background="{arc:ArcDesignTokenResource Background}">

        <Border Grid.Row="0" Margin="24,14,24,6" Padding="14,12"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
            <Grid ColumnDefinitions="*,Auto,80" RowDefinitions="Auto,Auto"
                  RowSpacing="8" ColumnSpacing="14">
                <TextBlock Classes="Caption" FontSize="11"
                           Text="{Binding WorkDirectoryText, Source={x:Static localizations:Lang.Current}}" />
                <Grid Grid.Column="1" ColumnDefinitions="224,112" ColumnSpacing="10">
                    <TextBlock Classes="Caption" FontSize="11"
                               Text="{Binding ModelText, Source={x:Static localizations:Lang.Current}}" />
                    <TextBlock Grid.Column="1" Classes="Caption" FontSize="11"
                               Text="{Binding ReasoningEffortText, Source={x:Static localizations:Lang.Current}}" />
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <arc:Input x:Name="WorkspaceInputBox" Size="Small"
                               ToolTip.Tip="{Binding WorkspaceStatusText}"
                               Text="{Binding WorkspaceInput, UpdateSourceTrigger=PropertyChanged}"
                               Placeholder="{Binding WorkspacePlaceholderText, Source={x:Static localizations:Lang.Current}}"
                               IsEnabled="{Binding !IsChangingWorkspace}" />
                    <arc:Button Grid.Column="1" Variant="Primary" Size="Small" MinWidth="72"
                                Content="{Binding ApplyText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding ApplyWorkspaceCommand}"
                                IsEnabled="{Binding CanApplyWorkspace}" />
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <arc:Select x:Name="ModelSelector" Width="224"
                                Placeholder="{Binding SelectModel, Source={x:Static localizations:Lang.Current}}"
                                ItemsSource="{Binding AvailableModels}"
                                SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                IsEnabled="{Binding !IsRunning}" />

                    <arc:Select x:Name="ReasoningEffortSelector" Width="112"
                                ToolTip.Tip="{Binding ReasoningEffortToolTip, Source={x:Static localizations:Lang.Current}}"
                                ItemsSource="{Binding AvailableReasoningEfforts}"
                                SelectedItem="{Binding SelectedReasoningEffort, Mode=TwoWay}"
                                DisplayMemberBinding="{ReflectionBinding DisplayName}"
                                IsEnabled="{Binding !IsRunning}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <arc:Button x:Name="TaskHistoryButton" Variant="Ghost" Size="Small"
                                ToolTip.Tip="{Binding SessionListTitle, Source={x:Static localizations:Lang.Current}}"
                                AutomationProperties.Name="{Binding SessionListTitle, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenTaskHistoryCommand}">
                        <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Clock3}" />
                    </arc:Button>
                    <arc:Button x:Name="OpenLogDirectoryButton" Variant="Ghost" Size="Small"
                                ToolTip.Tip="{Binding OpenLogDirectoryText, Source={x:Static localizations:Lang.Current}}"
                                AutomationProperties.Name="{Binding OpenLogDirectoryText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenLogDirectoryCommand}">
                        <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.FolderOpen}" />
                    </arc:Button>
                </StackPanel>
            </Grid>
        </Border>

        <arc:EmptyState Grid.Row="1" IsVisible="{Binding ShowWelcome}"
                        Label="CodingChatRoom"
                        Title="{Binding WelcomeTitleText, Source={x:Static localizations:Lang.Current}}"
                        Description="{Binding WelcomeDescriptionText, Source={x:Static localizations:Lang.Current}}"
                        Icon="{x:Static arc:ArcIcons.Sparkles}" />

        <ScrollViewer x:Name="MessagesScrollViewer" IsVisible="{Binding !ShowWelcome}"
                      Grid.Row="1"
                      Background="{arc:ArcDesignTokenResource Background}"
                      Padding="0"
                      AllowAutoHide="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesItemsControl" Margin="24,0,12,0" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageItemViewModel">
                        <Grid Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="8"
                                        IsVisible="{Binding IsAssistantMessage}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="26" Height="26"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                            Background="{arc:ArcDesignTokenResource AccentSubtle}">
                                        <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Sparkles}"
                                                      Foreground="{arc:ArcDesignTokenResource Accent}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Author}" Classes="AuthorName" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TimeText}" Classes="Timestamp" />
                                </StackPanel>
                                <Border Classes="MessageBubbleAssistant" HorizontalAlignment="Stretch">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding CopyBody, Source={x:Static localizations:Lang.Current}}"
                                                      Click="CopyContentMenuItem_OnClick" CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding CopyMessage, Source={x:Static localizations:Lang.Current}}"
                                                      Click="CopyFullMessageMenuItem_OnClick" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ItemsControl ItemsSource="{Binding MessageItems}" />
                                </Border>
                                <Border Classes="UsageSummaryBorder" HorizontalAlignment="Right"
                                        IsVisible="{Binding HasUsageDetails}">
                                    <TextBlock Classes="UsageSummaryText" Text="{Binding UsageSummaryText}"
                                               TextAlignment="Right" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" MaxWidth="720" Spacing="4"
                                        IsVisible="{Binding IsUserMessage}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <TextBlock Text="{Binding TimeText}" Classes="Timestamp" />
                                    <TextBlock Text="{Binding Author}" Classes="AuthorName" />
                                </StackPanel>
                                <Border Classes="MessageBubbleUser" HorizontalAlignment="Right">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding CopyBody, Source={x:Static localizations:Lang.Current}}"
                                                      Click="CopyContentMenuItem_OnClick" CommandParameter="{Binding}" />
                                            <MenuItem Header="{Binding CopyMessage, Source={x:Static localizations:Lang.Current}}"
                                                      Click="CopyFullMessageMenuItem_OnClick" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <ItemsControl ItemsSource="{Binding MessageItems}" />
                                </Border>
                            </StackPanel>

                            <Border Classes="MessageBubbleSystem" HorizontalAlignment="Center" MaxWidth="520"
                                    IsVisible="{Binding IsSystemMessage}">
                                <TextBlock Text="{Binding Content}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,8,24,16" RowDefinitions="Auto,Auto" RowSpacing="10">
            <Border x:Name="ComposerPanel" Padding="14,12,14,10"
                    Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8">
                    <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6"
                                  ItemsSource="{Binding PendingImages}" IsVisible="{Binding HasPendingImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ImageAttachmentViewModel">
                                <Border Margin="0,0,8,8" Padding="4"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                                    <Grid>
                                        <views:BinaryImage Width="96" Height="72" Data="{Binding Data}"
                                                           ToolTip.Tip="{Binding FileName}" />
                                        <arc:Button Width="26" Height="26" Variant="Secondary" Padding="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    ToolTip.Tip="{Binding RemoveImageText, Source={x:Static localizations:Lang.Current}}"
                                                    Click="RemoveImageButton_OnClick" CommandParameter="{Binding}">
                                            <arc:ArcGlyph Size="13" Data="{x:Static arc:ArcIcons.X}" />
                                        </arc:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="MessageInputTextBox"
                             Classes="ComposerInput"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{Binding MessageInputPlaceholder, Source={x:Static localizations:Lang.Current}}" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <arc:Select x:Name="AbilitySelector" MinWidth="156"
                                    ItemsSource="{Binding AvailableAbilities}"
                                    SelectedItem="{Binding SelectedAbility, Mode=TwoWay}"
                                    DisplayMemberBinding="{ReflectionBinding DisplayName}" />
                        <arc:Button Variant="Secondary" Size="Small"
                                    Content="{Binding AddImageText, Source={x:Static localizations:Lang.Current}}"
                                    Click="AddImageButton_OnClick" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="Caption" Margin="12,0"
                               VerticalAlignment="Center" IsVisible="{Binding !IsRunning}"
                               Text="{Binding InputShortcutText, Source={x:Static localizations:Lang.Current}}" />
                    <arc:Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Variant="Danger"
                                Size="Small" IsVisible="{Binding IsRunning}"
                                Content="{Binding StopText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding StopCommand}" />

                    <arc:Button Grid.Row="2" Grid.Column="2" x:Name="SendButton" Variant="Primary"
                                MinWidth="92" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Send}" />
                            <TextBlock Text="{Binding SendButtonText}" />
                        </StackPanel>
                    </arc:Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <WrapPanel x:Name="RunOptionsPanel" Orientation="Horizontal" ItemSpacing="14" LineSpacing="6"
                           VerticalAlignment="Center">
                    <arc:Checkbox x:Name="LoopIterationCheckBox" MinHeight="30"
                                  Content="{Binding LoopIterationText, Source={x:Static localizations:Lang.Current}}"
                                  IsChecked="{Binding IsLoopIterationEnabled}" />
                    <arc:Checkbox x:Name="AutomaticCompressionCheckBox" MinHeight="30"
                                  Content="{Binding AutomaticCompressionText, Source={x:Static localizations:Lang.Current}}"
                                  IsChecked="{Binding IsAutomaticCompressionEnabled}" />
                    <arc:Checkbox x:Name="EnableDotNetRunCheckBox" MinHeight="30"
                                  Content="{Binding EnableDotNetRunText, Source={x:Static localizations:Lang.Current}}"
                                  IsChecked="{Binding IsDotNetRunEnabled}"
                                  ToolTip.Tip="{Binding EnableDotNetRunToolTip, Source={x:Static localizations:Lang.Current}}" />
                    <arc:Checkbox x:Name="ResponsesApiToggleButton" MinHeight="30"
                                  Content="{Binding ResponsesApiText, Source={x:Static localizations:Lang.Current}}"
                                  IsChecked="{Binding IsResponsesApiEnabled, Mode=TwoWay}"
                                  ToolTip.Tip="{Binding ResponsesApiToolTip, Source={x:Static localizations:Lang.Current}}"
                                  AutomationProperties.Name="{Binding ResponsesApiText, Source={x:Static localizations:Lang.Current}}" />
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <arc:Button x:Name="CompressConversationButton" Variant="Ghost" Size="Small"
                                Content="{Binding CompressConversationText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding CompressConversationCommand}"
                                IsEnabled="{Binding CanCompressConversation}" />
                    <arc:Button x:Name="StopLanguageServerButton" Variant="Ghost" Size="Small"
                                Content="{Binding StopLanguageServerText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding StopLanguageServerCommand}"
                                ToolTip.Tip="{Binding StopLanguageServerToolTip, Source={x:Static localizations:Lang.Current}}" />
                    <arc:Button x:Name="NewSessionButton" Variant="Ghost" Size="Small"
                                Content="{Binding NewSessionText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).SessionListViewModel.CreateNewSessionCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
