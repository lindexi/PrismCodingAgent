<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:views="using:PrismCodingAgent.AvaloniaShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.MainView" x:DataType="vm:MainViewModel">
    <Grid ColumnDefinitions="292,*" Background="Transparent">

        <Border Grid.ColumnSpan="2" Margin="20,10" Padding="14,10" VerticalAlignment="Top" ZIndex="10"
                IsVisible="{Binding HasErrorMessage}"
                Background="{arc:ArcDesignTokenResource WarningSubtle}"
                BorderBrush="{arc:ArcDesignTokenResource Warning}" BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource Warning}" />
        </Border>

        <Border Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0,0,1,0">
            <Grid Margin="14,24,14,16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="40,*" ColumnSpacing="10" Margin="4,0">
                    <Border Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}" Width="40" Height="40">
                        <Image Width="26" Height="26" Source="avares://PrismCodingAgent/Assets/Icons/CodingChatRoom_48x48.png" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="CodingChatRoom" FontSize="16" FontWeight="Bold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Text="{Binding ProductSubtitleText, Source={x:Static localizations:Lang.Current}}"
                                   FontSize="12" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                </Grid>

                <arc:Button Grid.Row="1" Variant="Primary" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Command="{Binding CreateWorkTaskCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Plus}" />
                        <TextBlock Text="{Binding NewWorkTaskText, Source={x:Static localizations:Lang.Current}}" />
                    </StackPanel>
                </arc:Button>

                <arc:Input Grid.Row="2" Size="Small"
                           Placeholder="{Binding WorkTaskSearchText, Source={x:Static localizations:Lang.Current}}"
                           Text="{Binding WorkTaskSearchText, UpdateSourceTrigger=PropertyChanged}">
                    <arc:Input.Prefix>
                        <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Search}" Opacity="0.7" />
                    </arc:Input.Prefix>
                </arc:Input>

                <TextBlock Grid.Row="3" Margin="4,2,4,0"
                           Text="{Binding WorkTaskListText, Source={x:Static localizations:Lang.Current}}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="-4,0,-4,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredWorkTasks}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkTaskItemViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="2,1">
                                        <arc:Button Variant="{Binding IsActive, Converter={StaticResource BoolToButtonVariant}}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8"
                                                    Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).ActivateWorkTaskCommand}"
                                                    CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                                    <Panel>
                                                        <arc:ArcGlyph Width="14" Height="14" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" Data="{x:Static arc:ArcIcons.Clock3}"
                                                                      IsVisible="{Binding !IsWorking}" />
                                                        <arc:ArcGlyph Width="14" Height="14" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" Data="{x:Static arc:ArcIcons.Sparkles}"
                                                                      Foreground="{arc:ArcDesignTokenResource Accent}"
                                                                      IsVisible="{Binding IsWorking}" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                           IsVisible="{Binding !IsEditing}" FontSize="13"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding DisplayName}" />
                                            </Grid>
                                        </arc:Button>

                                        <arc:DropdownMenu Grid.Column="1" VerticalAlignment="Center"
                                                          IsVisible="{Binding !IsEditing}">
                                            <arc:DropdownMenu.Trigger>
                                                <arc:Button Variant="Ghost" Size="Small"
                                                            ToolTip.Tip="{Binding MoreActionsText, Source={x:Static localizations:Lang.Current}}">
                                                    <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Ellipsis}" />
                                                </arc:Button>
                                            </arc:DropdownMenu.Trigger>
                                            <arc:MenuEntry Header="{Binding PinWorkTaskText, Source={x:Static localizations:Lang.Current}}"
                                                           Icon="{x:Static arc:ArcIcons.Star}"
                                                           Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).PinWorkTaskCommand}"
                                                           CommandParameter="{Binding}" />
                                            <arc:MenuEntry Header="{Binding RenameWorkTaskText, Source={x:Static localizations:Lang.Current}}"
                                                           Icon="{x:Static arc:ArcIcons.Pencil}"
                                                           Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).RenameWorkTaskCommand}"
                                                           CommandParameter="{Binding}" />
                                            <arc:MenuEntry Header="{Binding ArchiveWorkTaskText, Source={x:Static localizations:Lang.Current}}"
                                                           Icon="{x:Static arc:ArcIcons.Archive}"
                                                           Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).ArchiveWorkTaskCommand}"
                                                           CommandParameter="{Binding}" />
                                            <arc:MenuEntry Header="{Binding DeleteSessionText, Source={x:Static localizations:Lang.Current}}"
                                                           Icon="{x:Static arc:ArcIcons.Trash2}" IsDestructive="True"
                                                           HasSeparatorBefore="True"
                                                           Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).DeleteWorkTaskCommand}"
                                                           CommandParameter="{Binding}" />
                                        </arc:DropdownMenu>

                                        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="6"
                                              Margin="6,4" VerticalAlignment="Center" IsVisible="{Binding IsEditing}">
                                            <arc:Input Text="{Binding EditedDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                       Size="Small"
                                                       AutomationProperties.Name="{Binding RenameWorkTaskText, Source={x:Static localizations:Lang.Current}}" />
                                            <arc:Button Grid.Column="1" Variant="Primary" Size="Small"
                                                        Content="{Binding ConfirmTaskNameText, Source={x:Static localizations:Lang.Current}}"
                                                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).SaveWorkTaskNameCommand}"
                                                        CommandParameter="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding EmptyWorkTaskSearchText, Source={x:Static localizations:Lang.Current}}"
                                   Margin="14,20" TextWrapping="Wrap" HorizontalAlignment="Center"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   IsVisible="{Binding IsWorkTaskSearchEmpty}" />

                        <StackPanel Margin="0,10,0,0" IsVisible="{Binding HasFilteredArchivedWorkTasks}">
                            <TextBlock Text="{Binding ArchivedSearchResultsText, Source={x:Static localizations:Lang.Current}}"
                                       Margin="8,0,8,6" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            <ItemsControl ItemsSource="{Binding FilteredArchivedWorkTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArchivedWorkTaskItemViewModel">
                                        <Grid ColumnDefinitions="*,Auto" Margin="2,1">
                                            <arc:Button Variant="Ghost" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="10,8"
                                                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).RestoreWorkTaskCommand}"
                                                        CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="26,*" ColumnSpacing="10">
                                                    <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                                        <arc:ArcGlyph Width="14" Height="14" HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" Data="{x:Static arc:ArcIcons.Archive}"
                                                                      ToolTip.Tip="{Binding ArchivedTaskBadgeText, Source={x:Static localizations:Lang.Current}}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding DisplayName}" />
                                                </Grid>
                                            </arc:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="5" Spacing="4">
                    <Border Classes="Divider" Margin="6,0,6,8" />
                    <arc:Button Name="ArchiveButton"
                                Variant="{Binding IsArchiveOpen, Converter={StaticResource BoolToButtonVariant}}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding OpenArchiveCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Archive}" />
                            <TextBlock Text="{Binding ArchiveNavigationText, Source={x:Static localizations:Lang.Current}}" />
                        </StackPanel>
                    </arc:Button>
                    <arc:Button Name="HistoryButton"
                                Variant="{Binding IsHistoryOpen, Converter={StaticResource BoolToButtonVariant}}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding OpenHistoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Clock3}" />
                            <TextBlock Text="{Binding AllSessionsText, Source={x:Static localizations:Lang.Current}}" />
                        </StackPanel>
                    </arc:Button>
                    <arc:Button Name="SettingsButton"
                                Variant="{Binding IsSettingsOpen, Converter={StaticResource BoolToButtonVariant}}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Settings}" />
                            <TextBlock Text="{Binding SettingsNavigationText, Source={x:Static localizations:Lang.Current}}" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="0,8,8,8"
                CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
                Background="{arc:ArcDesignTokenResource Background}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Panel IsVisible="{Binding IsChatOpen}">
                    <Panel IsEnabled="{Binding !!ChatViewModel.AvailableModels.Count}">
                        <views:ChatView DataContext="{Binding ChatViewModel}" />
                    </Panel>
                    <Border IsVisible="{Binding !ChatViewModel.AvailableModels.Count}"
                            Background="{arc:ArcDesignTokenResource Scrim}" Padding="24,32">
                        <Border Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
                                BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                                MaxWidth="1040">
                            <Grid RowDefinitions="Auto,*,Auto" DataContext="{Binding SettingsViewModel}"
                                  x:DataType="vm:SettingsViewModel">
                                <StackPanel Margin="24,20,24,16" Spacing="6">
                                    <TextBlock Text="{Binding ModelSetupTitle, Source={x:Static localizations:Lang.Current}}"
                                               FontSize="20" FontWeight="SemiBold"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <TextBlock Text="{Binding ModelSetupRequiredText, Source={x:Static localizations:Lang.Current}}"
                                               FontSize="13" TextWrapping="Wrap"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </StackPanel>
                                <Border Grid.Row="1"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="0,1">
                                    <ScrollViewer x:Name="ModelSetupScrollViewer" HorizontalScrollBarVisibility="Disabled" Padding="0">
                                        <Border Padding="20,12"><views:ModelSettingsView /></Border>
                                    </ScrollViewer>
                                </Border>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="24,16">
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    <arc:Button Grid.Column="1" Variant="Primary"
                                                Content="{Binding SaveModelSettingsText, Source={x:Static localizations:Lang.Current}}"
                                                Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Panel>

                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsArchiveOpen}">
                    <arc:Button Variant="Ghost" Margin="24,16" HorizontalAlignment="Left"
                                Content="{Binding BackToChatText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding CloseHistoryCommand}" />
                    <views:ArchivedWorkTasksView Grid.Row="1" />
                </Grid>

                <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsHistoryOpen}">
                    <arc:Button Variant="Ghost" Margin="24,16" HorizontalAlignment="Left"
                                Content="{Binding BackToChatText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding CloseHistoryCommand}" />
                    <views:SessionListView Grid.Row="1" DataContext="{Binding SessionListViewModel}" />
                </Grid>

                <Panel IsVisible="{Binding IsSettingsOpen}">
                    <views:SettingsView DataContext="{Binding SettingsViewModel}" />
                </Panel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
