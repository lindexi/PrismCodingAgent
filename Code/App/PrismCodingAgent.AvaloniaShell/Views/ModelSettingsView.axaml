<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:views="using:PrismCodingAgent.AvaloniaShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.AvaloniaShell.ViewModels"
             xmlns:views11="clr-namespace:PrismCodingAgent.AvaloniaShell.Views"
             x:Class="PrismCodingAgent.AvaloniaShell.Views.ModelSettingsView" x:DataType="vm:SettingsViewModel">
    <StackPanel Spacing="14" IsEnabled="{Binding !IsBusy}">
        <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderSettingsViewModel">
                    <Border Padding="16" Margin="0,4"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                        <StackPanel Spacing="14">
                            <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Right"
                                        Content="{Binding RemoveModelServiceText, Source={x:Static localizations:Lang.Current}}"
                                        Foreground="{arc:ArcDesignTokenResource Danger}"
                                        Command="{Binding $parent[views11:ModelSettingsView].((vm:SettingsViewModel)DataContext).RemoveProviderCommand}"
                                        CommandParameter="{Binding}" />
                            <views11:ModelServiceConnectionView />
                            <views11:OpenAIModelCatalogView />
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelSettingsViewModel">
                                        <Border Padding="12" Margin="0,4"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding ModelProviderText, Source={x:Static localizations:Lang.Current}}"
                                                                   Classes="FieldLabel" />
                                                        <arc:Input Size="Small" Text="{Binding Provider}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6">
                                                        <TextBlock Text="{Binding ModelDisplayNameText, Source={x:Static localizations:Lang.Current}}"
                                                                   Classes="FieldLabel" />
                                                        <arc:Input Size="Small" Text="{Binding ModelName}" />
                                                    </StackPanel>
                                                    <arc:Button Grid.Column="2" Variant="Ghost" Size="Small"
                                                                VerticalAlignment="Bottom"
                                                                ToolTip.Tip="{Binding SetupRemoveModel, Source={x:Static localizations:Lang.Current}}"
                                                                Command="{Binding $parent[ItemsControl].((vm:ProviderSettingsViewModel)DataContext).RemoveModelCommand}"
                                                                CommandParameter="{Binding}">
                                                        <arc:ArcGlyph Size="15" Data="{x:Static arc:ArcIcons.Trash2}"
                                                                      Foreground="{arc:ArcDesignTokenResource Danger}" />
                                                    </arc:Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{Binding ModelApiIdText, Source={x:Static localizations:Lang.Current}}"
                                                                   Classes="FieldLabel" />
                                                        <arc:Input Size="Small" Text="{Binding ModelId}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6">
                                                        <TextBlock Text="{Binding ModelContextSizeText, Source={x:Static localizations:Lang.Current}}"
                                                                   Classes="FieldLabel" />
                                                        <NumericUpDown Value="{Binding ContextWindowSize}" Minimum="1"
                                                                       Maximum="100000000" MinHeight="32" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="6">
                                                        <TextBlock Text="{Binding ModelOutputSizeText, Source={x:Static localizations:Lang.Current}}"
                                                                   Classes="FieldLabel" />
                                                        <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1"
                                                                       Maximum="10000000" MinHeight="32" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel>
                                                    <arc:Checkbox Content="{Binding ModelReasoningText, Source={x:Static localizations:Lang.Current}}"
                                                                  IsChecked="{Binding SupportsReasoning}" Margin="0,0,16,0" />
                                                    <arc:Checkbox Content="{Binding ModelToolsText, Source={x:Static localizations:Lang.Current}}"
                                                                  IsChecked="{Binding SupportsToolCall}" Margin="0,0,16,0" />
                                                    <arc:Checkbox Content="{Binding ModelImagesText, Source={x:Static localizations:Lang.Current}}"
                                                                  IsChecked="{Binding SupportsImageInput}" Margin="0,0,16,0" />
                                                    <arc:Checkbox Content="{Binding ModelFastText, Source={x:Static localizations:Lang.Current}}"
                                                                  IsChecked="{Binding IsFlash}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <arc:Button Variant="Secondary"
                    Content="{Binding AddModelServiceText, Source={x:Static localizations:Lang.Current}}"
                    Command="{Binding AddProviderCommand}" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
