<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc">
    <Style Selector="Border.MessageBubbleAssistant">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.MessageBubbleUser">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.MessageBubbleSystem">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBlock.AuthorName">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.Timestamp">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.SecondaryLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="Border.UsageSummaryBorder">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
    </Style>
    <Style Selector="TextBlock.UsageSummaryText">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
</Styles>
