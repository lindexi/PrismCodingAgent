<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PrismCodingAgent</AssemblyName>
    <RootNamespace>PrismCodingAgent.AvaloniaShell</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\CodingChatRoom.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetCampus.SourceLocalizations" Version="0.1.1-alpha.6" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="TKCode.Arc" Version="0.3.0-preview.5" />
    <PackageReference Include="TKCode.Arc.Fonts" Version="0.3.0-preview.5" />
    <PackageReference Include="TKCode.Arc.Special" Version="0.3.0-preview.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Lib\AgentLib\AgentLib.Coding\AgentLib.Coding.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrismCodingAgent.AvaloniaShell.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Icons\CodingChatRoom.ico" />
    <AvaloniaResource Include="Assets\Icons\CodingChatRoom_48x48.png" />
    <AvaloniaResource Include="Styles\Controls.axaml" />
    <AvaloniaResource Include="Styles\MessageBubble.axaml" />
  </ItemGroup>
</Project>
