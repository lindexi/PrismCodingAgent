<TextBox xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:arc="using:TKCode.Arc"
         xmlns:localizations="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
         x:Class="PrismCodingAgent.CodingShell.Views.SecretInput"
         x:Name="SecretField"
         PasswordChar="●" VerticalContentAlignment="Center">
    <TextBox.InnerRightContent>
        <ToggleButton x:Name="RevealButton" Focusable="False"
                      IsChecked="{Binding #SecretField.RevealPassword, Mode=TwoWay}"
                      Width="32" Padding="7" Margin="0"
                      VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                      CornerRadius="0,3,3,0" Background="Transparent" BorderThickness="0">
            <ToggleButton.Styles>
                <Style Selector="ToggleButton">
                    <Setter Property="ToolTip.Tip"
                            Value="{Binding SetupRevealKeyText, Source={x:Static localizations:Lang.Current}}" />
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding SetupRevealKeyText, Source={x:Static localizations:Lang.Current}}" />
                </Style>
                <Style Selector="ToggleButton:checked">
                    <Setter Property="ToolTip.Tip"
                            Value="{Binding SetupHideKeyText, Source={x:Static localizations:Lang.Current}}" />
                    <Setter Property="AutomationProperties.Name"
                            Value="{Binding SetupHideKeyText, Source={x:Static localizations:Lang.Current}}" />
                </Style>
            </ToggleButton.Styles>
            <arc:ArcGlyph Size="18" Data="{x:Static arc:ArcIcons.Eye}"
                          Foreground="{StaticResource TextSecondaryBrush}" />
        </ToggleButton>
    </TextBox.InnerRightContent>
</TextBox>