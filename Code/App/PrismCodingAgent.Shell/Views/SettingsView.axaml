<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:views="using:PrismCodingAgent.CodingShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.CodingShell.ViewModels"
             x:Class="PrismCodingAgent.CodingShell.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource SettingsBackgroundBrush}">
        <Border Grid.Row="0" Classes="SettingsHeader" Padding="32,24,32,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" HorizontalAlignment="Stretch">
                <Button Classes="SettingsBack"
                        Content="{Binding BackArrowText, Source={x:Static localizations:Lang.Current}}"
                        ToolTip.Tip="{Binding BackToChatText, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingsNavigationText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsPageTitle" />
                    <TextBlock Text="{Binding SettingsSubtitle, Source={x:Static localizations:Lang.Current}}" Classes="Subtitle" />
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="Primary accent SaveSettings"
                        Content="{Binding SaveChangesText, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,8,32,32" MaxWidth="1120"
                        Spacing="8"
                        HorizontalAlignment="Stretch">
                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding LanguageText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                        <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding LanguageTags}" SelectedItem="{Binding LanguageTag, Mode=TwoWay}" />
                        <TextBlock Text="{Binding LanguageHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding DeepSeekApiKeyText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                        <views:SecretInput x:Name="DeepSeekApiKeyInput" Text="{Binding DeepSeekApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding DeepSeekApiKeyHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="SettingsIntro" Padding="18" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Classes="IntroIcon">
                            <TextBlock Text="⚙"
                                       FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WorkspaceConfiguration, Source={x:Static localizations:Lang.Current}}" Classes="Eyebrow" />
                            <TextBlock Text="{Binding WorkspaceConfigurationDescription, Source={x:Static localizations:Lang.Current}}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#22313F" />
                            <TextBlock Text="{Binding WorkspaceConfigurationHint, Source={x:Static localizations:Lang.Current}}"
                                       Classes="SettingsHint"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="SectionTag" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReloadRequired, Source={x:Static localizations:Lang.Current}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon SandboxIcon">
                                <TextBlock Text="&gt;_"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SandboxAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding SandboxTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding SandboxDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding IsWindowsSandboxEnabled}"
                                          OnContent="{Binding NetworkProxyEnabledText, Source={x:Static localizations:Lang.Current}}"
                                          OffContent="{Binding NetworkProxyDisabledText, Source={x:Static localizations:Lang.Current}}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Border Classes="SandboxNotice" Padding="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="✓"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SandboxAccentBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SandboxTrustHint, Source={x:Static localizations:Lang.Current}}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SandboxTextBrush}" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding IsWindowsSandboxEnabled}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding SandboxToolPath, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                                <TextBox Classes="Rounded SettingsInput"
                                         Text="{Binding WindowsSandboxToolPath}"
                                         PlaceholderText="C:\Tools\WinRemoteShell.exe" />
                                <TextBlock Text="{Binding SandboxToolHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding SandboxAddress, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                                <TextBox Classes="Rounded SettingsInput"
                                         Text="{Binding WindowsSandboxServerAddress}"
                                         PlaceholderText="127.0.0.1:12399"
                                         LostFocus="OnWindowsSandboxServerAddressLostFocus" />
                                <TextBlock Text="{Binding SandboxAddressHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding HasSandboxConnectionStatusMessage}">
                                    <ProgressBar Width="72"
                                                 IsIndeterminate="True"
                                                 IsVisible="{Binding IsSandboxConnectionTestRunning}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SandboxConnectionStatusMessage}"
                                               Foreground="{StaticResource SandboxTextBrush}"
                                               IsVisible="{Binding !IsSandboxConnectionStatusError}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SandboxConnectionStatusMessage}"
                                               Foreground="{StaticResource DangerBrush}"
                                               IsVisible="{Binding IsSandboxConnectionStatusError}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon">
                                <TextBlock Text="NET"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding NetworkProxySettingsTitle, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding NetworkProxySettingsDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding IsNetworkProxyEnabled}"
                                          OnContent="{Binding NetworkProxyEnabledText, Source={x:Static localizations:Lang.Current}}"
                                          OffContent="{Binding NetworkProxyDisabledText, Source={x:Static localizations:Lang.Current}}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="14" IsEnabled="{Binding IsNetworkProxyEnabled}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding NetworkProxyAddressLabel, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                                <TextBox Classes="Rounded SettingsInput"
                                         Text="{Binding NetworkProxyAddress}"
                                         PlaceholderText="{Binding NetworkProxyAddressPlaceholder, Source={x:Static localizations:Lang.Current}}" />
                                <TextBlock Text="{Binding NetworkProxyAddressHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <CheckBox IsChecked="{Binding BypassProxyOnLocal}"
                                          Content="{Binding BypassProxyOnLocalText, Source={x:Static localizations:Lang.Current}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BypassProxyOnLocalHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon">
                                <TextBlock Text="LSP"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding LanguageServerSettingsTitle, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding LanguageServerSettingsDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Classes="Primary accent"
                                        Content="{Binding InstallOrUpdateLanguageServerText, Source={x:Static localizations:Lang.Current}}"
                                        Click="OnInstallOrUpdateLanguageServerClick" />
                                <Button Content="{Binding CopyLanguageServerInstallCommandText, Source={x:Static localizations:Lang.Current}}"
                                        ToolTip.Tip="{Binding CopyLanguageServerInstallCommandToolTip, Source={x:Static localizations:Lang.Current}}"
                                        Click="OnCopyLanguageServerInstallCommandClick" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding LanguageServerInstallHint, Source={x:Static localizations:Lang.Current}}"
                                   Classes="SettingsHint"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon">
                                <TextBlock Text="MD"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding InstructionsTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding InstructionsDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding IsCopilotInstructionsEnabled}"
                                          OnContent="{Binding NetworkProxyEnabledText, Source={x:Static localizations:Lang.Current}}"
                                          OffContent="{Binding NetworkProxyDisabledText, Source={x:Static localizations:Lang.Current}}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="6" IsEnabled="{Binding IsCopilotInstructionsEnabled}">
                            <TextBlock Text="{Binding InstructionsPath, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                            <TextBox Classes="Rounded SettingsInput"
                                     Text="{Binding CopilotInstructionsPath}"
                                     PlaceholderText="{Binding InstructionsPlaceholder, Source={x:Static localizations:Lang.Current}}" />
                            <TextBlock Text="{Binding InstructionsHint, Source={x:Static localizations:Lang.Current}}"
                                       Classes="SettingsHint"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{Binding ModelConfigurationTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                        <TextBox Text="{Binding PrimaryModel}" PlaceholderText="{Binding DefaultModelHint, Source={x:Static localizations:Lang.Current}}" Classes="Rounded SettingsInput" />
                        <views:ModelSettingsView />
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24" x:Name="CpaQuotaSettings">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding QuotaTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                            <Button Grid.Column="1" Classes="Secondary" Content="{Binding QuotaAdd, Source={x:Static localizations:Lang.Current}}" Command="{Binding Quotas.AddServiceCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Quotas.Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CpaQuotaServiceViewModel">
                                    <Border BorderBrush="#E4E9F0" BorderThickness="0,1,0,0" Padding="0,16,0,16">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Width="32" MinWidth="32" Height="32" MinHeight="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding QuotaRemove, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Quotas.RemoveServiceCommand}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate>
                                                            <Border Background="Transparent">
                                                                <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#50555C" StrokeThickness="1.5" Data="M1,1 L11,11 M11,1 L1,11" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Text="{Binding QuotaAddress, Source={x:Static localizations:Lang.Current}}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Classes="Rounded" Text="{Binding Address}" PlaceholderText="https://example.com" />
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Text="{Binding QuotaKey, Source={x:Static localizations:Lang.Current}}" VerticalAlignment="Center" />
                                                <views:SecretInput Grid.Column="1" Classes="Rounded" Text="{Binding ManagementKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Text="{Binding QuotaName, Source={x:Static localizations:Lang.Current}}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Classes="Rounded" Text="{Binding Name}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <CheckBox Content="{Binding QuotaPrimary, Source={x:Static localizations:Lang.Current}}" IsChecked="{Binding IsPrimary}" />
                                                <Button Grid.Column="1" Classes="Secondary" Content="{Binding QuotaRefresh, Source={x:Static localizations:Lang.Current}}" Command="{Binding RefreshCommand}" />
                                            </Grid>
                                            <TextBlock Text="{Binding DetailText}" IsVisible="{Binding HasResults}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0" IsVisible="{Binding HasResults}">
                                                <TextBlock Text="{Binding QuotaObserved, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" />
                                                <TextBlock Text="{Binding ObservedText}" Classes="SettingsHint" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Classes="StatusBar"
                Padding="28,12"
                IsVisible="{Binding HasStatusMessage}">
            <Grid ColumnDefinitions="*,Auto" MaxWidth="1040" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Width="100"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
