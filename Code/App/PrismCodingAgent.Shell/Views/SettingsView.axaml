<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:views="using:PrismCodingAgent.CodingShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.CodingShell.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="PrismCodingAgent.CodingShell.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Expander.PurposeSection">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <Border BorderBrush="{StaticResource SettingsCardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                            <ToggleButton Classes="PurposeHeader" Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch">
                                <Grid ColumnDefinitions="20,*" HorizontalAlignment="Stretch">
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" HorizontalAlignment="Left" />
                                    <Path Grid.Column="0" Classes="PurposeChevron" Data="M 2,2 L 8,8 L 2,14" Width="16" Height="16" Stroke="#536171" StrokeThickness="2" VerticalAlignment="Center" />
                                </Grid>
                            </ToggleButton>
                        </Border>
                        <TextBlock Margin="20,4,0,0" Text="{Binding PurposeValidationFailed, Source={x:Static localizations:Lang.Current}}" IsVisible="{Binding HasPurposeErrors}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                        <ContentPresenter Margin="20,12,0,0" Content="{TemplateBinding Content}" IsVisible="{TemplateBinding IsExpanded}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.PurposeHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.PurposeHeader:pointerover">
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>
        <Style Selector="ToggleButton.PurposeHeader:checked Path.PurposeChevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="ToggleButton.PurposeHeader:focus-visible">
            <Setter Property="Background" Value="#EEF6FF" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector="Border.PurposeRow">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="{Binding $parent[ItemsControl].Tag}" />
        </Style>
        <Style Selector="Border.PurposeRow.CustomPurpose">
            <Setter Property="Width" Value="{Binding $parent[ItemsControl].Bounds.Width}" />
        </Style>
        <Style Selector="Border.CustomPurpose">
            <Setter Property="BorderBrush" Value="{StaticResource SettingsCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ComboBox.PurposeSelector">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE2E9" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="Button.PurposeAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style Selector="ComboBox.PurposeError, TextBox.PurposeError">
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource SettingsBackgroundBrush}">
        <Border Grid.Row="0" Classes="SettingsHeader" Padding="32,24,32,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" HorizontalAlignment="Stretch">
                <Button Classes="SettingsBack"
                        Content="{Binding BackArrowText, Source={x:Static localizations:Lang.Current}}"
                        ToolTip.Tip="{Binding BackToChatText, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SettingsNavigationText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsPageTitle" />
                    <TextBlock Text="{Binding SettingsSubtitle, Source={x:Static localizations:Lang.Current}}" Classes="Subtitle" />
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="Primary accent SaveSettings"
                        Content="{Binding SaveChangesText, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,8,32,32" MaxWidth="1120"
                        Spacing="8"
                        HorizontalAlignment="Stretch">
                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding LanguageText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                        <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding LanguageTags}" SelectedItem="{Binding LanguageTag, Mode=TwoWay}" />
                        <TextBlock Text="{Binding LanguageHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding DeepSeekApiKeyText, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                        <views:SecretInput x:Name="DeepSeekApiKeyInput" Text="{Binding DeepSeekApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding DeepSeekApiKeyHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Classes="SettingsIntro" Padding="18" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Classes="IntroIcon">
                            <TextBlock Text="⚙"
                                       FontSize="20"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding WorkspaceConfiguration, Source={x:Static localizations:Lang.Current}}" Classes="Eyebrow" />
                            <TextBlock Text="{Binding WorkspaceConfigurationDescription, Source={x:Static localizations:Lang.Current}}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#22313F" />
                            <TextBlock Text="{Binding WorkspaceConfigurationHint, Source={x:Static localizations:Lang.Current}}"
                                       Classes="SettingsHint"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="SectionTag" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReloadRequired, Source={x:Static localizations:Lang.Current}}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon SandboxIcon">
                                <TextBlock Text="&gt;_"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SandboxAccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding SandboxTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding SandboxDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding IsWindowsSandboxEnabled}"
                                          OnContent="{Binding NetworkProxyEnabledText, Source={x:Static localizations:Lang.Current}}"
                                          OffContent="{Binding NetworkProxyDisabledText, Source={x:Static localizations:Lang.Current}}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <Border Classes="SandboxNotice" Padding="14">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="✓"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SandboxAccentBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SandboxTrustHint, Source={x:Static localizations:Lang.Current}}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SandboxTextBrush}" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding IsWindowsSandboxEnabled}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding SandboxToolPath, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                                <TextBox Classes="Rounded SettingsInput"
                                         Text="{Binding WindowsSandboxToolPath}"
                                         PlaceholderText="C:\Tools\WinRemoteShell.exe" />
                                <TextBlock Text="{Binding SandboxToolHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding SandboxAddress, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                                <TextBox Classes="Rounded SettingsInput"
                                         Text="{Binding WindowsSandboxServerAddress}"
                                         PlaceholderText="127.0.0.1:12399"
                                         LostFocus="OnWindowsSandboxServerAddressLostFocus" />
                                <TextBlock Text="{Binding SandboxAddressHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8"
                                      IsVisible="{Binding HasSandboxConnectionStatusMessage}">
                                    <ProgressBar Width="72"
                                                 IsIndeterminate="True"
                                                 IsVisible="{Binding IsSandboxConnectionTestRunning}"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SandboxConnectionStatusMessage}"
                                               Foreground="{StaticResource SandboxTextBrush}"
                                               IsVisible="{Binding !IsSandboxConnectionStatusError}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SandboxConnectionStatusMessage}"
                                               Foreground="{StaticResource DangerBrush}"
                                               IsVisible="{Binding IsSandboxConnectionStatusError}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon">
                                <TextBlock Text="NET"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding NetworkProxySettingsTitle, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding NetworkProxySettingsDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding IsNetworkProxyEnabled}"
                                          OnContent="{Binding NetworkProxyEnabledText, Source={x:Static localizations:Lang.Current}}"
                                          OffContent="{Binding NetworkProxyDisabledText, Source={x:Static localizations:Lang.Current}}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="14" IsEnabled="{Binding IsNetworkProxyEnabled}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding NetworkProxyAddressLabel, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                                <TextBox Classes="Rounded SettingsInput"
                                         Text="{Binding NetworkProxyAddress}"
                                         PlaceholderText="{Binding NetworkProxyAddressPlaceholder, Source={x:Static localizations:Lang.Current}}" />
                                <TextBlock Text="{Binding NetworkProxyAddressHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <CheckBox IsChecked="{Binding BypassProxyOnLocal}"
                                          Content="{Binding BypassProxyOnLocalText, Source={x:Static localizations:Lang.Current}}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding BypassProxyOnLocalHint, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsHint"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon">
                                <TextBlock Text="LSP"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding LanguageServerSettingsTitle, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding LanguageServerSettingsDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Classes="Primary accent"
                                        Content="{Binding InstallOrUpdateLanguageServerText, Source={x:Static localizations:Lang.Current}}"
                                        Click="OnInstallOrUpdateLanguageServerClick" />
                                <Button Content="{Binding CopyLanguageServerInstallCommandText, Source={x:Static localizations:Lang.Current}}"
                                        ToolTip.Tip="{Binding CopyLanguageServerInstallCommandToolTip, Source={x:Static localizations:Lang.Current}}"
                                        Click="OnCopyLanguageServerInstallCommandClick" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding LanguageServerInstallHint, Source={x:Static localizations:Lang.Current}}"
                                   Classes="SettingsHint"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Classes="SectionIcon">
                                <TextBlock Text="MD"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding InstructionsTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                                <TextBlock Text="{Binding InstructionsDescription, Source={x:Static localizations:Lang.Current}}"
                                           Classes="Subtitle"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding IsCopilotInstructionsEnabled}"
                                          OnContent="{Binding NetworkProxyEnabledText, Source={x:Static localizations:Lang.Current}}"
                                          OffContent="{Binding NetworkProxyDisabledText, Source={x:Static localizations:Lang.Current}}"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="6" IsEnabled="{Binding IsCopilotInstructionsEnabled}">
                            <TextBlock Text="{Binding InstructionsPath, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" />
                            <TextBox Classes="Rounded SettingsInput"
                                     Text="{Binding CopilotInstructionsPath}"
                                     PlaceholderText="{Binding InstructionsPlaceholder, Source={x:Static localizations:Lang.Current}}" />
                            <TextBlock Text="{Binding InstructionsHint, Source={x:Static localizations:Lang.Current}}"
                                       Classes="SettingsHint"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="ModelConfigurationHeading" Text="{Binding ModelConfigurationTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                        <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                            <Border x:Name="PrimaryModelFields" Grid.Column="1" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PrimaryModelLabel" Text="{Binding DefaultModelLabel, Source={x:Static localizations:Lang.Current}}" Classes="SettingsLabel" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="PrimaryModelHint" Grid.Row="1" Grid.Column="1" Text="{Binding DefaultModelHint, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" />
                            <TextBox x:Name="PrimaryModelInput" Grid.Column="1" HorizontalAlignment="Left" Width="{Binding #PrimaryModelFields.Bounds.Width}" MaxWidth="300" VerticalAlignment="Center"
                                     Text="{Binding PrimaryModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding #PrimaryModelLabel}"
                                     Classes="Rounded SettingsInput" />
                        </Grid>
                        <Expander x:Name="PurposeModelsExpander" Classes="PurposeSection" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock x:Name="PurposeModelsHeading" FontWeight="SemiBold" Text="{Binding PurposeModelsTitle, Source={x:Static localizations:Lang.Current}}" />
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding PurposeModelsHelp, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" TextWrapping="Wrap" MaxWidth="792" HorizontalAlignment="Left" />
                                <ItemsControl x:Name="PurposeModelsList" DataContextChanged="OnPurposeListDataContextChanged" Width="{Binding $parent[StackPanel].Bounds.Width}" MaxWidth="776" HorizontalAlignment="Left" SizeChanged="OnPurposeListSizeChanged">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel ItemSpacing="32" LineSpacing="8" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PurposeModelSettingsViewModel">
                                            <Border Classes="PurposeRow" Classes.CustomPurpose="{Binding CanEditPurpose}">
                                                <Grid ColumnDefinitions="64,8,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" DataContextChanged="OnPurposeFieldsDataContextChanged" SizeChanged="OnPurposeFieldsSizeChanged">
                                                    <TextBlock Text="{Binding DisplayName, StringFormat='{}{0}:'}" IsVisible="{Binding IsBuiltIn}" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" />
                                                    <TextBox Grid.Column="0" Height="36" VerticalContentAlignment="Center" ToolTip.Tip="{Binding PurposeKey}" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Hidden" Classes="Rounded SettingsInput" Classes.PurposeError="{Binding PurposeError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" IsVisible="{Binding CanEditPurpose}"
                                                             Text="{Binding PurposeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="{Binding PurposeKeyHint, Source={x:Static localizations:Lang.Current}}"
                                                             AutomationProperties.Name="{Binding PurposeKeyLabel, Source={x:Static localizations:Lang.Current}}" />
                                                    <ComboBox Grid.Column="2" Classes="PurposeSelector" Classes.PurposeError="{Binding ModelError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" ToolTip.Tip="{Binding SelectedModel.DisplayName}" ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="0" MaxWidth="300"
                                                              AutomationProperties.Name="{Binding PurposeModelLabel, Source={x:Static localizations:Lang.Current}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:PurposeModelOptionViewModel">
                                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Grid.Row="1" Text="{Binding PurposeError}" IsVisible="{Binding PurposeError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ModelError}" IsVisible="{Binding ModelError, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                                                    <Button Grid.Column="3" HorizontalAlignment="Left" Classes="PurposeAction" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="4" IsVisible="{Binding CanRemove}"
                                                            Content="{Binding PurposeRemove, Source={x:Static localizations:Lang.Current}}"
                                                            Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).RemovePurposeModelCommand}" CommandParameter="{Binding}" />
                                                    <TextBlock Grid.Column="1" Text="：" VerticalAlignment="Center" IsVisible="False" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddPurposeModelButton" Classes="PurposeAction" Margin="0,4,0,0" Padding="0,4" HorizontalAlignment="Left" Content="{Binding PurposeAdd, Source={x:Static localizations:Lang.Current}}" Command="{Binding AddPurposeModelCommand}" />
                            </StackPanel>
                        </Expander>
                        <StackPanel Spacing="24">
                            <Border x:Name="ConnectionServicesSection" Height="1" Background="{StaticResource SettingsCardBorderBrush}" />
                            <views:ModelSettingsView />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="SettingsCard" Padding="24" x:Name="CpaQuotaSettings">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding QuotaTitle, Source={x:Static localizations:Lang.Current}}" Classes="SettingsSectionTitle" />
                            <Button Grid.Column="1" Classes="Secondary" Content="{Binding QuotaAdd, Source={x:Static localizations:Lang.Current}}" Command="{Binding Quotas.AddServiceCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Quotas.Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CpaQuotaServiceViewModel">
                                    <Border BorderBrush="#E4E9F0" BorderThickness="0,1,0,0" Padding="0,16,0,16">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Width="32" MinWidth="32" Height="32" MinHeight="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding QuotaRemove, Source={x:Static localizations:Lang.Current}}"
                                                    Command="{Binding $parent[views:SettingsView].((vm:SettingsViewModel)DataContext).Quotas.RemoveServiceCommand}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate>
                                                            <Border Background="Transparent">
                                                                <Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#50555C" StrokeThickness="1.5" Data="M1,1 L11,11 M11,1 L1,11" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Text="{Binding QuotaAddress, Source={x:Static localizations:Lang.Current}}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Classes="Rounded" Text="{Binding Address}" PlaceholderText="https://example.com" />
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Text="{Binding QuotaKey, Source={x:Static localizations:Lang.Current}}" VerticalAlignment="Center" />
                                                <views:SecretInput Grid.Column="1" Classes="Rounded" Text="{Binding ManagementKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
                                                <TextBlock Text="{Binding QuotaName, Source={x:Static localizations:Lang.Current}}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Classes="Rounded" Text="{Binding Name}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <CheckBox Content="{Binding QuotaPrimary, Source={x:Static localizations:Lang.Current}}" IsChecked="{Binding IsPrimary}" />
                                                <Button Grid.Column="1" Classes="Secondary" Content="{Binding QuotaRefresh, Source={x:Static localizations:Lang.Current}}" Command="{Binding RefreshCommand}" />
                                            </Grid>
                                            <TextBlock Text="{Binding DetailText}" IsVisible="{Binding HasResults}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,-4,0,0" IsVisible="{Binding HasResults}">
                                                <TextBlock Text="{Binding QuotaObserved, Source={x:Static localizations:Lang.Current}}" Classes="SettingsHint" />
                                                <TextBlock Text="{Binding ObservedText}" Classes="SettingsHint" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Classes="StatusBar"
                Padding="28,12"
                IsVisible="{Binding HasStatusMessage}">
            <Grid ColumnDefinitions="*,Auto" MaxWidth="1040" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             Width="100"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
