<UserControl x:Class="PrismCodingAgent.CodingShell.Views.SecretInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             x:Name="SecretField" MinHeight="32">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="MaskedInput" PasswordChar="●" Padding="10,3" BorderThickness="0"
                         VerticalContentAlignment="Center" PasswordChanged="OnPasswordChanged" />
            <TextBox x:Name="RevealedInput" Grid.Column="0" Padding="10,3" BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Visibility="Collapsed" TextChanged="OnTextChanged" />
            <ToggleButton x:Name="RevealButton" Grid.Column="1" Focusable="False" Background="Transparent"
                          BorderThickness="0" Padding="7" Checked="OnRevealChanged" Unchecked="OnRevealChanged">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="ToolTip"
                                Value="{Binding SetupRevealKeyText, Source={x:Static l:Lang.Current}}" />
                        <Setter Property="AutomationProperties.Name"
                                Value="{Binding SetupRevealKeyText, Source={x:Static l:Lang.Current}}" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="ToolTip"
                                        Value="{Binding SetupHideKeyText, Source={x:Static l:Lang.Current}}" />
                                <Setter Property="AutomationProperties.Name"
                                        Value="{Binding SetupHideKeyText, Source={x:Static l:Lang.Current}}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
                <Path Data="M 1,10 C 6,1 14,1 19,10 C 14,19 6,19 1,10 Z M 13,10 A 3,3 0 1 1 7,10 A 3,3 0 1 1 13,10"
                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="18" Height="18"
                      Stretch="Uniform" />
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>