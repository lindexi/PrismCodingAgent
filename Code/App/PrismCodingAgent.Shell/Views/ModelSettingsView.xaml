<UserControl x:Class="PrismCodingAgent.CodingShell.Views.ModelSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
 xmlns:views="clr-namespace:PrismCodingAgent.CodingShell.Views"
 FontSize="14" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="5,3"/><Setter Property="BorderBrush" Value="#CCD5DF"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="ModelLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#344454"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource ComposerOption}"/>
  <Style x:Key="NumberInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="BorderThickness" Value="1,1,0,1"/><Setter Property="BorderBrush" Value="#888888"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4,0,0,4"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NumberStep" TargetType="Button">
   <Setter Property="Width" Value="34"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="StepSurface" Background="White" BorderBrush="#888888" BorderThickness="{TemplateBinding BorderThickness}"><Path x:Name="Arrow" Data="M 0,8 L 8,0 L 16,8" Stroke="#333333" StrokeThickness="1.5" Width="16" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="Content" Value="▼"><Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,8 L 16,0"/></Trigger><Trigger Property="Content" Value="▼"><Setter TargetName="StepSurface" Property="CornerRadius" Value="0,4,4,0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StepSurface" Property="Background" Value="#EEEEEE"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="StepSurface" Property="Background" Value="#DDDDDD"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StepSurface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="StepSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
  <ItemsControl ItemsSource="{Binding Providers}">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4">
     <StackPanel>
      <Button HorizontalAlignment="Right" Foreground="DarkRed" Content="{Binding RemoveModelServiceText, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=v:ModelSettingsView}}" CommandParameter="{Binding}"/>
      <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding SetupEndpointText, Source={x:Static l:Lang.Current}}" FontSize="12" FontWeight="SemiBold" Foreground="#344454" Margin="0,0,0,6"/><TextBox x:Name="EndpointInput" Height="38" Text="{Binding EndPoint, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding SetupEndpointHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding SetupKeyText, Source={x:Static l:Lang.Current}}" FontSize="12" FontWeight="SemiBold" Foreground="#344454" Margin="0,0,0,6"/><views:SecretInput Height="38" Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding SetupKeyHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/></StackPanel>
      </Grid>
      <views:OpenAIModelCatalogView/>
      <ItemsControl ItemsSource="{Binding Models}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="Transparent" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="12" Margin="0,4">
        <StackPanel>
         <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource ModelLabel}" Text="{Binding ModelProviderText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,6"/><TextBox x:Name="ProviderInput" Text="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource ModelLabel}" Text="{Binding ModelDisplayNameText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,6"/><TextBox x:Name="ModelNameInput" Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <Button Grid.Column="4" VerticalAlignment="Bottom" Foreground="DarkRed" Content="×" ToolTip="{Binding SetupRemoveModel, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.RemoveModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
         </Grid>
         <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Style="{StaticResource ModelLabel}" Text="{Binding ModelApiIdText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,6"/><TextBox x:Name="ModelIdInput" Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource ModelLabel}" Text="{Binding ModelContextSizeText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource NumberInput}" x:Name="ContextSizeInput" Tag="100000000" Text="{Binding ContextWindowSize, UpdateSourceTrigger=Explicit, ValidatesOnExceptions=True}" LostFocus="OnNumericLostFocus"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource NumberStep}" Content="▲" BorderThickness="1,1,0,1" Tag="{Binding ElementName=ContextSizeInput}" Click="OnIncrement"/><Button Style="{StaticResource NumberStep}" Content="▼" Tag="{Binding ElementName=ContextSizeInput}" Click="OnDecrement"/></StackPanel></Grid></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource ModelLabel}" Text="{Binding ModelOutputSizeText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Style="{StaticResource NumberInput}" x:Name="OutputSizeInput" Tag="10000000" Text="{Binding MaxOutputTokens, UpdateSourceTrigger=Explicit, ValidatesOnExceptions=True}" LostFocus="OnNumericLostFocus"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource NumberStep}" Content="▲" BorderThickness="1,1,0,1" Tag="{Binding ElementName=OutputSizeInput}" Click="OnIncrement"/><Button Style="{StaticResource NumberStep}" Content="▼" Tag="{Binding ElementName=OutputSizeInput}" Click="OnDecrement"/></StackPanel></Grid></StackPanel>
         </Grid>
         <WrapPanel>
          <CheckBox Content="{Binding ModelReasoningText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding SupportsReasoning}" Margin="0,0,16,0"/>
          <CheckBox Content="{Binding ModelToolsText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding SupportsToolCall}" Margin="0,0,16,0"/>
          <CheckBox Content="{Binding ModelImagesText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding SupportsImageInput}" Margin="0,0,16,0"/>
          <CheckBox Content="{Binding ModelFastText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding IsFlash}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button HorizontalAlignment="Left" MinHeight="38" BorderThickness="1" Padding="12,10" FontWeight="SemiBold" BorderBrush="#B9D8F2" Foreground="{StaticResource PrimaryBrush}" Margin="0,16,0,0" Content="{Binding AddModelServiceText, Source={x:Static l:Lang.Current}}" Command="{Binding AddProviderCommand}"/>
 </StackPanel>
</UserControl>
