<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:vm="clr-namespace:PrismCodingAgent.CodingShell.ViewModels"
             xmlns:chat="clr-namespace:PrismCodingAgent.CodingShell.Services.Chat"
             x:Class="PrismCodingAgent.CodingShell.Views.ChatSettingsView"
             x:DataType="vm:ChatViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style Selector="TextBlock.Detail">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="SwitchTrack" Height="24" CornerRadius="12" Background="#D7DEE7">
                        <Grid x:Name="PART_MovingKnobs">
                            <Ellipse x:Name="SwitchKnob" Width="18" Height="18" Margin="3"
                                     HorizontalAlignment="Left" Fill="White" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="ToggleSwitch:checked /template/ Ellipse#SwitchKnob">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="ToggleSwitch:pointerover /template/ Border#SwitchTrack">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="ToggleSwitch:focus-visible /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.OptionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Margin="32,24" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ChatSettingsTitle, Source={x:Static localizations:Lang.Current}}"
                       FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="CloseChatSettingsButton" Grid.Column="1" Classes="Flat"
                    Width="32" Height="32" Padding="8" Command="{Binding ToggleChatSettingsCommand}"
                    ToolTip.Tip="{Binding CloseChatSettingsText, Source={x:Static localizations:Lang.Current}}"
                    AutomationProperties.Name="{Binding CloseChatSettingsText, Source={x:Static localizations:Lang.Current}}">
                <Path Width="14" Height="14" Stretch="Uniform" Stroke="#50555C"
                      StrokeThickness="1.8" StrokeLineCap="Round"
                      Data="M1,1 L13,13 M13,1 L1,13" />
            </Button>
        </Grid>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,0,28,16">
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Classes="SectionTitle" Margin="0,0,0,12"
                               Text="{Binding ChatWorkspaceSection, Source={x:Static localizations:Lang.Current}}" />
                    <TextBlock Text="{Binding WorkDirectoryText, Source={x:Static localizations:Lang.Current}}"
                               Margin="0,0,0,8" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="SettingsWorkspaceInput" MinWidth="0" Classes="Rounded"
                                 Text="{Binding WorkspaceInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding !IsChangingWorkspace}" />
                        <Button Grid.Column="1" Classes="Primary accent" Height="32"
                                Content="{Binding ApplyText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding ApplyWorkspaceCommand}" />
                    </Grid>
                    <TextBlock Classes="Detail" Text="{Binding WorkspaceStatusText}" Margin="0,6,0,8"
                               ToolTip.Tip="{Binding WorkspaceStatusText}" />
                    <Grid ColumnDefinitions="*,1,180" ColumnSpacing="20" Margin="0,12,0,8">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding ModelText, Source={x:Static localizations:Lang.Current}}" />
                            <ComboBox x:Name="SettingsModelSelector" ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}" IsEnabled="{Binding !IsRunning}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageModelOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#E4E9F0" />
                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock
                                Text="{Binding ReasoningEffortText, Source={x:Static localizations:Lang.Current}}" />
                            <ComboBox x:Name="SettingsReasoningSelector"
                                      ItemsSource="{Binding AvailableReasoningEfforts}"
                                      SelectedItem="{Binding SelectedReasoningEffort}" IsEnabled="{Binding !IsRunning}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReasoningEffortOptionViewModel">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0" />
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Classes="SectionTitle" Margin="0,12,0,8"
                               Text="{Binding ChatRunSettingsTitle, Source={x:Static localizations:Lang.Current}}" />
                    <Grid ColumnDefinitions="*,44" MinHeight="48">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding AutomaticCompressionText, Source={x:Static localizations:Lang.Current}}" />
                        <ToggleSwitch x:Name="ChatAutomaticCompressionToggle" Grid.Column="1"
                                      AutomationProperties.Name="{Binding AutomaticCompressionText, Source={x:Static localizations:Lang.Current}}"
                                      IsChecked="{Binding RunOptions.EnableAutomaticCompression, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="#ECEDEF" />
                    <Grid ColumnDefinitions="*,44" MinHeight="48">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding EnableDotNetRunText, Source={x:Static localizations:Lang.Current}}" />
                        <ToggleSwitch x:Name="ChatDotNetRunToggle" Grid.Column="1"
                                      AutomationProperties.Name="{Binding EnableDotNetRunText, Source={x:Static localizations:Lang.Current}}"
                                      IsChecked="{Binding RunOptions.EnableDotNetRun, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="#ECEDEF" />
                    <Grid ColumnDefinitions="*,44" MinHeight="48">
                        <TextBlock Classes="OptionTitle" Text="{Binding EnableWebSearchText, Source={x:Static localizations:Lang.Current}}" />
                        <ToggleSwitch x:Name="ChatWebSearchToggle" Grid.Column="1"
                                      AutomationProperties.Name="{Binding EnableWebSearchText, Source={x:Static localizations:Lang.Current}}"
                                      IsChecked="{Binding RunOptions.EnableWebSearch, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="#ECEDEF" />
                    <Grid ColumnDefinitions="*,44" MinHeight="48">
                        <TextBlock Classes="OptionTitle" Text="{Binding EnableWebFetchText, Source={x:Static localizations:Lang.Current}}" />
                        <ToggleSwitch x:Name="ChatWebFetchToggle" Grid.Column="1"
                                      AutomationProperties.Name="{Binding EnableWebFetchText, Source={x:Static localizations:Lang.Current}}"
                                      IsChecked="{Binding RunOptions.EnableWebFetch, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="#ECEDEF" />
                    <Grid ColumnDefinitions="*,44" MinHeight="48">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding ResponsesApiText, Source={x:Static localizations:Lang.Current}}" />
                        <ToggleSwitch x:Name="ChatResponsesApiToggle" Grid.Column="1"
                                      AutomationProperties.Name="{Binding ResponsesApiText, Source={x:Static localizations:Lang.Current}}"
                                      IsChecked="{Binding IsResponsesApiEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
                <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0" />
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                    <Border x:Name="LoopSettingsGroup" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding LoopSettingsTitle, Source={x:Static localizations:Lang.Current}}"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LoopSettingsHint, Source={x:Static localizations:Lang.Current}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <Grid ColumnDefinitions="*,180" MinHeight="48">
                                <TextBlock Classes="OptionTitle"
                                           Text="{Binding LoopMaximumIterations, Source={x:Static localizations:Lang.Current}}" />
                                <TextBox x:Name="LoopMaximumIterationsInput" Grid.Column="1" Height="32" MinHeight="32"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         Text="{Binding LoopOptions.MaximumIterations, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding LoopMaximumIterations, Source={x:Static localizations:Lang.Current}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,180" MinHeight="48">
                                <TextBlock Classes="OptionTitle"
                                           Text="{Binding LoopMaximumDuration, Source={x:Static localizations:Lang.Current}}" />
                                <TextBox x:Name="LoopMaximumDurationInput" Grid.Column="1" Height="32" MinHeight="32"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         Text="{Binding LoopOptions.MaximumDurationMinutes, Mode=TwoWay}"
                                         AutomationProperties.Name="{Binding LoopMaximumDuration, Source={x:Static localizations:Lang.Current}}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,180" MinHeight="48">
                                <TextBlock Classes="OptionTitle"
                                           Text="{Binding LoopConversation, Source={x:Static localizations:Lang.Current}}" />
                                <ComboBox x:Name="LoopConversationSelector" Grid.Column="1" Height="32" MinHeight="32"
                                          VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                          SelectedValueBinding="{ReflectionBinding Tag}"
                                          SelectedValue="{Binding LoopOptions.ConversationMode, Mode=TwoWay}">
                                    <ComboBoxItem
                                        DataContext="{ReflectionBinding LoopCompressHint, Source={x:Static localizations:Lang.Current}}"
                                        Tag="{x:Static chat:LoopConversationMode.Compress}"
                                        Content="{Binding LoopCompress, Source={x:Static localizations:Lang.Current}}" />
                                    <ComboBoxItem
                                        DataContext="{ReflectionBinding LoopRestartHint, Source={x:Static localizations:Lang.Current}}"
                                        Tag="{x:Static chat:LoopConversationMode.Restart}"
                                        Content="{Binding LoopRestart, Source={x:Static localizations:Lang.Current}}" />
                                    <ComboBoxItem
                                        DataContext="{ReflectionBinding LoopAppendHint, Source={x:Static localizations:Lang.Current}}"
                                        Tag="{x:Static chat:LoopConversationMode.Append}"
                                        Content="{Binding LoopAppend, Source={x:Static localizations:Lang.Current}}" />
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="LoopConversationHint"
                                       Text="{ReflectionBinding #LoopConversationSelector.SelectedItem.DataContext}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0" />
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Classes="SectionTitle" Margin="0,12,0,8"
                               Text="{Binding ChatServiceSection, Source={x:Static localizations:Lang.Current}}" />
                    <Grid ColumnDefinitions="*,Auto" MinHeight="48">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding LanguageServerSettingsTitle, Source={x:Static localizations:Lang.Current}}" />
                        <Button x:Name="StopLanguageServerButton" Grid.Column="1" Classes="Secondary"
                                VerticalAlignment="Center"
                                Content="{Binding StopLanguageServerText, Source={x:Static localizations:Lang.Current}}"
                                Command="{Binding StopLanguageServerCommand}" />
                    </Grid>
                </StackPanel>
                <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0" />
                <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
                    <TextBlock Classes="SectionTitle" Margin="0,12,0,8"
                               Text="{Binding ChatDiagnosticsSection, Source={x:Static localizations:Lang.Current}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,16">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding ChatProcessLabel, Source={x:Static localizations:Lang.Current}}" />
                        <Button x:Name="CopyPidButton" Classes="Flat" Padding="4,0" Click="CopyPidClicked"
                                ToolTip.Tip="{Binding ChatCopyPid, Source={x:Static localizations:Lang.Current}}">
                            <TextBlock x:Name="ProcessIdText" FontFamily="Cascadia Mono,Consolas,monospace" />
                        </Button>
                        <Button x:Name="LaunchDebuggerButton" Classes="Secondary"
                                Content="{Binding ChatLaunchDebugger, Source={x:Static localizations:Lang.Current}}"
                                Click="LaunchDebuggerClicked" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,8">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding ChatLogFileLabel, Source={x:Static localizations:Lang.Current}}" />
                        <TextBox x:Name="LogFileInput" Grid.Column="1" MinWidth="0" IsReadOnly="True" />
                        <Button x:Name="OpenLogFileButton" Grid.Column="2" Classes="Secondary"
                                Content="{Binding ChatOpenFile, Source={x:Static localizations:Lang.Current}}"
                                Click="OpenLogClicked" />
                        <Button x:Name="OpenLogFolderButton" Grid.Column="3" Classes="Secondary"
                                Content="{Binding ChatOpenFolder, Source={x:Static localizations:Lang.Current}}"
                                Click="OpenLogFolderClicked" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,8">
                        <TextBlock Classes="OptionTitle"
                                   Text="{Binding ChatArchiveLabel, Source={x:Static localizations:Lang.Current}}" />
                        <TextBox x:Name="SessionsDirectoryInput" Grid.Column="1" MinWidth="0" IsReadOnly="True" />
                        <Button x:Name="OpenSessionsButton" Grid.Column="2" Classes="Secondary"
                                Content="{Binding ChatOpenFolder, Source={x:Static localizations:Lang.Current}}"
                                Click="OpenSessionsClicked" />
                    </Grid>
                    <TextBlock x:Name="DiagnosticsFeedback" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                               IsVisible="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>