<UserControl x:Class="PrismCodingAgent.CodingShell.Views.ModelSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:views="clr-namespace:PrismCodingAgent.CodingShell.Views">
    <Border Background="#38000000" Padding="24,32">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" MaxWidth="1040">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="24,20,24,16">
                    <TextBlock Text="{Binding ModelSetupTitle, Source={x:Static l:Lang.Current}}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ModelSetupRequiredText, Source={x:Static l:Lang.Current}}" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="20,12"><views:ModelSettingsView/></Border>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="2" Margin="24,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Content="{Binding SaveModelSettingsText, Source={x:Static l:Lang.Current}}"/>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
