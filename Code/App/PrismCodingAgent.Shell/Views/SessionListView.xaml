<UserControl x:Class="PrismCodingAgent.CodingShell.Views.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations">
    <Border Background="{StaticResource BackgroundBrush}" Padding="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Button x:Name="HistoryBack" HorizontalAlignment="Left" Margin="0,0,0,16" Content="{Binding BackToChatText, Source={x:Static l:Lang.Current}}" Command="{Binding CloseHistoryCommand}"/>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SessionListTitle, Source={x:Static l:Lang.Current}}" FontSize="20" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Content="{Binding OrganizeHistoryText, Source={x:Static l:Lang.Current}}" Command="{Binding OrganizeHistoryCommand}"/>
                    <Button x:Name="RefreshHistory" Background="#E0E0E0" Content="{Binding RefreshHistoryText, Source={x:Static l:Lang.Current}}" Command="{Binding SessionListViewModel.ReloadCommand}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <TextBox x:Name="HistorySearch" Height="32" Padding="10,3" BorderBrush="#888888" Text="{Binding SessionListViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding HistorySearchText, Source={x:Static l:Lang.Current}}" ToolTip="{Binding HistorySearchText, Source={x:Static l:Lang.Current}}"/>
                <TextBlock Text="{Binding HistorySearchText, Source={x:Static l:Lang.Current}}" Foreground="#B8B8B8" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=HistorySearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Row="3">
                <TextBlock Text="{Binding HistoryOrganizationResult}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding HistoryLoadingText, Source={x:Static l:Lang.Current}}" Visibility="{Binding SessionListViewModel.IsLoading, Converter={StaticResource BooleanVisibility}}"/>
                <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding SessionListViewModel.IsLoading, Converter={StaticResource BooleanVisibility}}"/>
                <TextBlock Text="{Binding SessionListViewModel.ErrorMessage}" Foreground="DarkRed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Grid Grid.Row="4">
                <TextBlock x:Name="HistoryEmpty" Text="{Binding EmptySessionListText, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SessionListViewModel.IsEmpty, Converter={StaticResource BooleanVisibility}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HistoryItems" ItemsSource="{Binding SessionListViewModel.Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="HistoryRow" MouseLeftButtonDown="OnHistoryMouseLeftButtonDown" Background="{StaticResource SurfaceBrush}" BorderBrush="#10000000" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,16,8" MinHeight="32">
                                            <TextBlock x:Name="HistoryTitle" Text="{Binding Title}" FontSize="14" MinHeight="32" Padding="0,6,0,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanVisibility}}">
                                                <TextBox x:Name="HistoryTitleEditor" Text="{Binding EditedTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding EditSessionTitleText, Source={x:Static l:Lang.Current}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button x:Name="SaveHistoryTitle" Content="{Binding SaveTitleText, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.SessionListViewModel.SaveTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button x:Name="CancelHistoryTitle" Margin="8,0,0,0" Content="{Binding CancelEditText, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.SessionListViewModel.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Margin="0,0,20,0">
                                            <TextBlock TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"><Run Text="{Binding WorkTaskText, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding Subtitle, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspacePath}" Foreground="{StaticResource TextSecondaryBrush}"><Run Text="{Binding SessionWorkspaceText, Source={x:Static l:Lang.Current}, Mode=OneWay}"/><Run Text="{Binding WorkspacePath, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <Border Padding="10,4" CornerRadius="6" VerticalAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BackgroundBrush}" Margin="0,0,8,0" Visibility="{Binding IsCurrent, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="{Binding CurrentSessionText, Source={x:Static l:Lang.Current}}" FontWeight="SemiBold"/></Border>
                                            <Button x:Name="EditHistoryTitle" Width="32" Height="32" Padding="7" ToolTip="{Binding EditSessionTitleText, Source={x:Static l:Lang.Current}}" AutomationProperties.Name="{Binding EditSessionTitleText, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.SessionListViewModel.EditTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}" Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button x:Name="OpenHistorySession" Background="#E0E0E0" Padding="15,6" Margin="0,0,8,0" Content="{Binding OpenSessionText, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button x:Name="DeleteHistorySession" Width="32" Height="32" Padding="7" Foreground="#C53636" ToolTip="{Binding DeleteSessionText, Source={x:Static l:Lang.Current}}" AutomationProperties.Name="{Binding DeleteSessionText, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.SessionListViewModel.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><Path Width="16" Height="16" Stretch="Uniform" Fill="#C53636" Data="M6,19 C6,20.1 6.9,21 8,21 L16,21 C17.1,21 18,20.1 18,19 L18,7 L6,7 Z M19,4 L15.5,4 L14.5,3 L9.5,3 L8.5,4 L5,4 L5,6 L19,6 Z"/></Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
