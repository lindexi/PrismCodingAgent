<UserControl x:Class="PrismCodingAgent.CodingShell.Views.ChatSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
 xmlns:chat="clr-namespace:PrismCodingAgent.CodingShell.Services.Chat">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,24,0,8"/></Style>
  <Style x:Key="SettingRow" TargetType="Grid"><Setter Property="MinHeight" Value="48"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource ShellSecondaryButton}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#D7DEE7"><Ellipse x:Name="Knob" Width="18" Height="18" Margin="3" Fill="White" HorizontalAlignment="Left"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource PrimaryBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Margin="32,24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding ChatSettingsTitle, Source={x:Static l:Lang.Current}}" FontSize="22" FontWeight="SemiBold"/>
   <Button x:Name="CloseChatSettingsButton" Grid.Column="1" Width="32" Height="32" Padding="8" Background="Transparent" BorderThickness="0" Command="{Binding ToggleChatSettingsCommand}" ToolTip="{Binding CloseChatSettingsText, Source={x:Static l:Lang.Current}}" AutomationProperties.Name="{Binding CloseChatSettingsText, Source={x:Static l:Lang.Current}}">
    <Path Width="14" Height="14" Stretch="Uniform" Stroke="#50555C" StrokeThickness="1.8" Data="M1,1 L13,13 M13,1 L1,13"/>
   </Button>
  </Grid>
  <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="28,0,28,16">
   <StackPanel MaxWidth="720">
    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,12" Text="{Binding ChatWorkspaceSection, Source={x:Static l:Lang.Current}}"/>
    <TextBlock Text="{Binding WorkDirectoryText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="SettingsWorkspaceInput" Text="{Binding WorkspaceInput, UpdateSourceTrigger=PropertyChanged}">
      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsChangingWorkspace}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
     </TextBox>
     <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding ApplyText, Source={x:Static l:Lang.Current}}" Command="{Binding ApplyWorkspaceCommand}"/>
    </Grid>
    <TextBlock Text="{Binding WorkspaceStatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkspaceStatusText}" Margin="0,6,0,8"/>
    <Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="41"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="{Binding ModelText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,8"/>
      <ComboBox x:Name="SettingsModelSelector" ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName">
       <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
      </ComboBox>
     </StackPanel>
     <Border Grid.Column="1" Width="1" Background="#E4E9F0"/>
     <StackPanel Grid.Column="2"><TextBlock Text="{Binding ReasoningEffortText, Source={x:Static l:Lang.Current}}" Margin="0,0,0,8"/>
      <ComboBox x:Name="SettingsReasoningSelector" ItemsSource="{Binding AvailableReasoningEfforts}" SelectedItem="{Binding SelectedReasoningEffort}" DisplayMemberPath="DisplayName">
       <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></ComboBox.Style>
      </ComboBox>
     </StackPanel>
    </Grid>
    </StackPanel>
    <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0"/>
    <StackPanel MaxWidth="720">
    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding ChatRunSettingsTitle, Source={x:Static l:Lang.Current}}"/>
    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding AutomaticCompressionText, Source={x:Static l:Lang.Current}}"/><CheckBox x:Name="ChatAutomaticCompressionToggle" Grid.Column="1" AutomationProperties.Name="{Binding AutomaticCompressionText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding RunOptions.EnableAutomaticCompression, Mode=TwoWay}"/></Grid>
    <Border Height="1" Background="#ECEDEF"/>
    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding EnableDotNetRunText, Source={x:Static l:Lang.Current}}"/><CheckBox x:Name="ChatDotNetRunToggle" Grid.Column="1" AutomationProperties.Name="{Binding EnableDotNetRunText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding RunOptions.EnableDotNetRun, Mode=TwoWay}"/></Grid>
    <Border Height="1" Background="#ECEDEF"/>
    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ResponsesApiText, Source={x:Static l:Lang.Current}}"/><CheckBox x:Name="ChatResponsesApiToggle" Grid.Column="1" AutomationProperties.Name="{Binding ResponsesApiText, Source={x:Static l:Lang.Current}}" IsChecked="{Binding IsResponsesApiEnabled, Mode=TwoWay}"/></Grid>
    </StackPanel>
    <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0"/>
    <StackPanel MaxWidth="720">
    <Border x:Name="LoopSettingsGroup" Margin="0,12,0,0"><StackPanel>
     <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="{Binding LoopSettingsTitle, Source={x:Static l:Lang.Current}}"/>
     <TextBlock Text="{Binding LoopSettingsHint, Source={x:Static l:Lang.Current}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
     <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LoopMaximumIterations, Source={x:Static l:Lang.Current}}"/><TextBox x:Name="LoopMaximumIterationsInput" Grid.Column="1" VerticalAlignment="Center" Text="{Binding LoopOptions.MaximumIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></Grid>
     <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LoopMaximumDuration, Source={x:Static l:Lang.Current}}"/><TextBox x:Name="LoopMaximumDurationInput" Grid.Column="1" VerticalAlignment="Center" Text="{Binding LoopOptions.MaximumDurationMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></Grid>
     <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LoopConversation, Source={x:Static l:Lang.Current}}"/>
      <ComboBox x:Name="LoopConversationSelector" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding LoopOptions.ConversationMode, Mode=TwoWay}">
       <ComboBoxItem Tag="{x:Static chat:LoopConversationMode.Compress}" DataContext="{Binding LoopCompressHint, Source={x:Static l:Lang.Current}}" Content="{Binding LoopCompress, Source={x:Static l:Lang.Current}}"/>
       <ComboBoxItem Tag="{x:Static chat:LoopConversationMode.Restart}" DataContext="{Binding LoopRestartHint, Source={x:Static l:Lang.Current}}" Content="{Binding LoopRestart, Source={x:Static l:Lang.Current}}"/>
       <ComboBoxItem Tag="{x:Static chat:LoopConversationMode.Append}" DataContext="{Binding LoopAppendHint, Source={x:Static l:Lang.Current}}" Content="{Binding LoopAppend, Source={x:Static l:Lang.Current}}"/>
      </ComboBox>
     </Grid>
     <TextBlock x:Name="LoopConversationHint" Text="{Binding SelectedItem.DataContext, ElementName=LoopConversationSelector}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel></Border>
    </StackPanel>
    <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0"/>
    <StackPanel MaxWidth="720">
    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding ChatServiceSection, Source={x:Static l:Lang.Current}}"/>
    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LanguageServerSettingsTitle, Source={x:Static l:Lang.Current}}"/><Button x:Name="StopLanguageServerButton" Grid.Column="1" Content="{Binding StopLanguageServerText, Source={x:Static l:Lang.Current}}" Command="{Binding StopLanguageServerCommand}"/></Grid>
    </StackPanel>
    <Border Height="1" Background="#DDE2E8" Margin="0,12,0,0"/>
    <StackPanel MaxWidth="720">
    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,12,0,8" Text="{Binding ChatDiagnosticsSection, Source={x:Static l:Lang.Current}}"/>
    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
     <TextBlock Text="{Binding ChatProcessLabel, Source={x:Static l:Lang.Current}}"/>
     <Button x:Name="CopyPidButton" Margin="8,0" Padding="4,0" Background="Transparent" BorderThickness="0" Click="CopyPidClicked" ToolTip="{Binding ChatCopyPid, Source={x:Static l:Lang.Current}}"><TextBlock x:Name="ProcessIdText" FontFamily="Consolas"/></Button>
     <Button x:Name="LaunchDebuggerButton" Content="{Binding ChatLaunchDebugger, Source={x:Static l:Lang.Current}}" Click="LaunchDebuggerClicked"/>
    </StackPanel>
    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding ChatLogFileLabel, Source={x:Static l:Lang.Current}}" Margin="0,0,8,0"/>
     <TextBox x:Name="LogFileInput" Grid.Column="1" IsReadOnly="True"/>
     <Button x:Name="OpenLogFileButton" Grid.Column="2" Margin="8,0,0,0" Content="{Binding ChatOpenFile, Source={x:Static l:Lang.Current}}" Click="OpenLogClicked"/>
     <Button x:Name="OpenLogFolderButton" Grid.Column="3" Margin="8,0,0,0" Content="{Binding ChatOpenFolder, Source={x:Static l:Lang.Current}}" Click="OpenLogFolderClicked"/>
    </Grid>
    <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding ChatArchiveLabel, Source={x:Static l:Lang.Current}}" Margin="0,0,8,0"/>
     <TextBox x:Name="SessionsDirectoryInput" Grid.Column="1" IsReadOnly="True"/>
     <Button x:Name="OpenSessionsButton" Grid.Column="2" Margin="8,0,0,0" Content="{Binding ChatOpenFolder, Source={x:Static l:Lang.Current}}" Click="OpenSessionsClicked"/>
    </Grid>
    <TextBlock x:Name="DiagnosticsFeedback" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
