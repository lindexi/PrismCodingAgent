<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localizations="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:views="using:PrismCodingAgent.CodingShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.CodingShell.ViewModels"
             x:Class="PrismCodingAgent.CodingShell.Views.ModelSettingsView" x:DataType="vm:SettingsViewModel">
    <StackPanel Spacing="16" IsEnabled="{Binding !IsBusy}">
        <ItemsControl ItemsSource="{Binding Providers}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProviderSettingsViewModel">
                    <Border Classes="ProviderCard" Padding="16" Margin="0">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding SetupConnectionLabel, Source={x:Static localizations:Lang.Current}}"
                                           Classes="SettingsLabel" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                Content="{Binding RemoveModelServiceText, Source={x:Static localizations:Lang.Current}}"
                                Classes="QuietDanger" HorizontalAlignment="Right"
                                Command="{Binding $parent[views:ModelSettingsView].((vm:SettingsViewModel)DataContext).RemoveProviderCommand}"
                                CommandParameter="{Binding}" />
                            </Grid>
                            <views:ModelServiceConnectionView />
                            <views:OpenAIModelCatalogView>
                                <views:OpenAIModelCatalogView.Styles>
                                    <Style Selector="StackPanel#CatalogPanel">
                                        <Setter Property="Spacing" Value="6" />
                                    </Style>
                                </views:OpenAIModelCatalogView.Styles>
                            </views:OpenAIModelCatalogView>
                            <ItemsControl ItemsSource="{Binding Models}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelSettingsViewModel">
                                        <Border Classes="ModelCard" Padding="12" Margin="0,4">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock
                                                            Text="{Binding ModelProviderText, Source={x:Static localizations:Lang.Current}}"
                                                            Classes="SettingsLabel" />
                                                        <TextBox Text="{Binding Provider}"
                                                                 Classes="Rounded SettingsInput" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6">
                                                        <TextBlock
                                                            Text="{Binding ModelDisplayNameText, Source={x:Static localizations:Lang.Current}}"
                                                            Classes="SettingsLabel" />
                                                        <TextBox Text="{Binding ModelName}"
                                                                 Classes="Rounded SettingsInput" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="×" Classes="IconDanger"
                                                            VerticalAlignment="Bottom"
                                                            ToolTip.Tip="{Binding SetupRemoveModel, Source={x:Static localizations:Lang.Current}}"
                                                            Command="{Binding $parent[ItemsControl].((vm:ProviderSettingsViewModel)DataContext).RemoveModelCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock
                                                            Text="{Binding ModelApiIdText, Source={x:Static localizations:Lang.Current}}"
                                                            Classes="SettingsLabel" />
                                                        <TextBox Text="{Binding ModelId}"
                                                                 Classes="Rounded SettingsInput" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6">
                                                        <TextBlock
                                                            Text="{Binding ModelContextSizeText, Source={x:Static localizations:Lang.Current}}"
                                                            Classes="SettingsLabel" />
                                                        <NumericUpDown Value="{Binding ContextWindowSize}" Minimum="1"
                                                                       Maximum="100000000" Classes="SettingsInput" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="6">
                                                        <TextBlock
                                                            Text="{Binding ModelOutputSizeText, Source={x:Static localizations:Lang.Current}}"
                                                            Classes="SettingsLabel" />
                                                        <NumericUpDown Value="{Binding MaxOutputTokens}" Minimum="1"
                                                                       Maximum="10000000" Classes="SettingsInput" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel>
                                                    <CheckBox
                                                        Content="{Binding ModelReasoningText, Source={x:Static localizations:Lang.Current}}"
                                                        IsChecked="{Binding SupportsReasoning}" Margin="0,0,16,0" />
                                                    <CheckBox
                                                        Content="{Binding ModelToolsText, Source={x:Static localizations:Lang.Current}}"
                                                        IsChecked="{Binding SupportsToolCall}" Margin="0,0,16,0" />
                                                    <CheckBox
                                                        Content="{Binding ModelImagesText, Source={x:Static localizations:Lang.Current}}"
                                                        IsChecked="{Binding SupportsImageInput}" Margin="0,0,16,0" />
                                                    <CheckBox
                                                        Content="{Binding ModelFastText, Source={x:Static localizations:Lang.Current}}"
                                                        IsChecked="{Binding IsFlash}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{Binding AddModelServiceText, Source={x:Static localizations:Lang.Current}}"
                Command="{Binding AddProviderCommand}" Classes="AddOutline" />
    </StackPanel>
</UserControl>