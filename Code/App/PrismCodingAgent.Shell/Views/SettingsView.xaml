<UserControl x:Class="PrismCodingAgent.CodingShell.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:views="clr-namespace:PrismCodingAgent.CodingShell.Views"
             xmlns:input="clr-namespace:PrismCodingAgent.CodingShell.Infrastructure"
             FontSize="12" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="PurposeVisibility" />
        <Style x:Key="PurposeSection" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="PurposeHeader" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalContentAlignment="Stretch" MinHeight="36" Background="Transparent" BorderThickness="0" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path x:Name="PurposeChevron" Data="M 2,2 L 8,8 L 2,14" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="PurposeContent" Content="{TemplateBinding Content}" Visibility="Collapsed" Margin="0,8,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="PurposeContent" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PurposeChevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PurposeErrorText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="38" /><Setter Property="Padding" Value="5,3" />
            <Setter Property="BorderBrush" Value="#CCD5DF" />
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#728091" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#344454" />
        </Style>
        <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource ComposerOption}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator" Width="20" Height="20" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="#777777" VerticalAlignment="Center">
                                <Path x:Name="Check" Width="12" Height="12" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 1,4 L 3,6 L 7,1"
                                      Stroke="White" StrokeThickness="1.5" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="#F3F3F3" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="#0078D7" />
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#17212B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Indicator" Property="Background" Value="#CCCCCC" />
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#CCCCCC" />
                                <Setter TargetName="Check" Property="Stroke" Value="#999999" />
                                <Setter Property="Foreground" Value="#AAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="SwitchTrack" Width="40" Height="20" CornerRadius="10" Background="White"
                                    BorderBrush="#777777" BorderThickness="1">
                                <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="#000000"
                                         HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <TextBlock x:Name="SwitchText" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding NetworkProxyDisabledText, Source={x:Static l:Lang.Current}}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#0078D7" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="White" />
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchText" Property="Text"
                                        Value="{Binding NetworkProxyEnabledText, Source={x:Static l:Lang.Current}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#17212B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#EEEEEE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#E5F1FB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E4E9F0" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" /><Setter Property="Margin" Value="0,4" />
        </Style>

    </UserControl.Resources>
    <Grid Background="#F9F9F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#F9F9F9" BorderBrush="#E4E9F0" BorderThickness="0,0,0,1" Padding="32,24,32,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button x:Name="BackButton" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="14"
                        FontWeight="SemiBold" Padding="12,7" Margin="0,0,20,0"
                        Content="{Binding BackArrowText, Source={x:Static l:Lang.Current}}"
                        ToolTip="{Binding BackToChatText, Source={x:Static l:Lang.Current}}"
                        Command="{Binding BackCommand}" />
                <Button x:Name="SaveButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Height="38" FontSize="14"
                        Padding="18,8" Content="{Binding SaveChangesText, Source={x:Static l:Lang.Current}}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <Button.Style><StaticResource ResourceKey="PrimaryButton" /></Button.Style>
                </Button>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="{Binding SettingsNavigationText, Source={x:Static l:Lang.Current}}" FontSize="28"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SettingsSubtitle, Source={x:Static l:Lang.Current}}"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <ProgressBar x:Name="SettingsProgress" Grid.Row="1" VerticalAlignment="Top" Height="4" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" Panel.ZIndex="1" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,8,32,32" MaxWidth="1120">
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding LanguageText, Source={x:Static l:Lang.Current}}" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ComboBox x:Name="LanguageSelector" Width="104" Height="32" HorizontalAlignment="Left"
                                  ItemsSource="{Binding LanguageTags}"
                                  SelectedItem="{Binding LanguageTag, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource SettingsHint}"
                                   Text="{Binding LanguageHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding DeepSeekApiKeyText, Source={x:Static l:Lang.Current}}" FontSize="15"
                                   FontWeight="SemiBold" Margin="0,0,0,12" />
                        <views:SecretInput x:Name="DeepSeekApiKeyInput" Height="32"
                                           Text="{Binding DeepSeekApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource SettingsHint}"
                                   Text="{Binding DeepSeekApiKeyHint, Source={x:Static l:Lang.Current}}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#E9F7F1" Margin="0,0,14,0">
                                <TextBlock Text="&gt;_" FontSize="12" FontWeight="Bold" Foreground="#118565"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SandboxTitle, Source={x:Static l:Lang.Current}}"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#17212B" />
                                <TextBlock Text="{Binding SandboxDescription, Source={x:Static l:Lang.Current}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="SandboxEnabled" Style="{StaticResource SettingsSwitch}"
                                      IsChecked="{Binding IsWindowsSandboxEnabled}"
                                      Content="{Binding NetworkProxyEnabledText, Source={x:Static l:Lang.Current}}" />
                        </Grid>
                        <Border Background="#F0F9F6" BorderBrush="#CDE9DF" BorderThickness="1" CornerRadius="8"
                                Padding="14" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✓" FontWeight="Bold" Foreground="#118565" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SandboxTrustHint, Source={x:Static l:Lang.Current}}"
                                           TextWrapping="Wrap" Foreground="#175F4D" />
                            </Grid>
                        </Border>
                        <Grid IsEnabled="{Binding IsWindowsSandboxEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding SandboxToolPath, Source={x:Static l:Lang.Current}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#344454" />
                                <TextBox x:Name="SandboxPath"
                                         Text="{Binding WindowsSandboxToolPath, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="32" Margin="0,6" />
                                <TextBlock Style="{StaticResource SettingsHint}"
                                           Text="{Binding SandboxToolHint, Source={x:Static l:Lang.Current}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SandboxAddress, Source={x:Static l:Lang.Current}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#344454" />
                                <TextBox x:Name="SandboxAddress" LostFocus="OnWindowsSandboxServerAddressLostFocus"
                                         Text="{Binding WindowsSandboxServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="32" Margin="0,6" />
                                <TextBlock Style="{StaticResource SettingsHint}"
                                           Text="{Binding SandboxAddressHint, Source={x:Static l:Lang.Current}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="SandboxProgress" IsIndeterminate="True" Height="4">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSandboxConnectionTestRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock x:Name="SandboxStatus" Text="{Binding SandboxConnectionStatusMessage}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSandboxConnectionStatusError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#EAF4FC" Margin="0,0,14,0">
                                <TextBlock Text="NET" FontSize="11" FontWeight="Bold" Foreground="#0078D7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding NetworkProxySettingsTitle, Source={x:Static l:Lang.Current}}"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#17212B" />
                                <TextBlock
                                    Text="{Binding NetworkProxySettingsDescription, Source={x:Static l:Lang.Current}}"
                                    Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                    Margin="0,3,12,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="ProxyEnabled" Style="{StaticResource SettingsSwitch}"
                                      IsChecked="{Binding IsNetworkProxyEnabled}" />
                        </Grid>
                        <StackPanel IsEnabled="{Binding IsNetworkProxyEnabled}">
                            <TextBlock Style="{StaticResource SettingsLabel}"
                                       Text="{Binding NetworkProxyAddressLabel, Source={x:Static l:Lang.Current}}" />
                            <TextBox x:Name="ProxyAddress" Style="{StaticResource SettingsInput}"
                                     input:TextBoxPlaceholder.Text="{Binding NetworkProxyAddressPlaceholder, Source={x:Static l:Lang.Current}}"
                                     Text="{Binding NetworkProxyAddress, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="32" Margin="0,6" />
                            <TextBlock Style="{StaticResource SettingsHint}"
                                       Text="{Binding NetworkProxyAddressHint, Source={x:Static l:Lang.Current}}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ProxyBypass" IsChecked="{Binding BypassProxyOnLocal}"
                                          Content="{Binding BypassProxyOnLocalText, Source={x:Static l:Lang.Current}}" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SettingsHint}"
                                           Text="{Binding BypassProxyOnLocalHint, Source={x:Static l:Lang.Current}}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#EAF4FC" Margin="0,0,14,0">
                                <TextBlock Text="LSP" FontSize="10" FontWeight="Bold" Foreground="#0078D7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock
                                    Text="{Binding LanguageServerSettingsTitle, Source={x:Static l:Lang.Current}}"
                                    FontSize="15" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding LanguageServerSettingsDescription, Source={x:Static l:Lang.Current}}"
                                    Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                    Margin="0,3,12,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="InstallLanguageServerButton" Style="{StaticResource PrimaryButton}"
                                        Content="{Binding InstallOrUpdateLanguageServerText, Source={x:Static l:Lang.Current}}"
                                        Click="OnInstallOrUpdateLanguageServerClick" Margin="0,0,8,0" />
                                <Button x:Name="CopyLanguageServerCommandButton" Background="#EEEEEE"
                                        Content="{Binding CopyLanguageServerInstallCommandText, Source={x:Static l:Lang.Current}}"
                                        ToolTip="{Binding CopyLanguageServerInstallCommandToolTip, Source={x:Static l:Lang.Current}}"
                                        Click="OnCopyLanguageServerInstallCommandClick" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingsHint}"
                                   Text="{Binding LanguageServerInstallHint, Source={x:Static l:Lang.Current}}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LanguageServerStatus" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                        <Trigger Property="Text" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="#EAF4FC" Margin="0,0,14,0">
                                <TextBlock Text="MD" FontSize="11" FontWeight="Bold" Foreground="#0078D7"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding InstructionsTitle, Source={x:Static l:Lang.Current}}"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstructionsDescription, Source={x:Static l:Lang.Current}}"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Margin="0,3,12,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="InstructionsEnabled"
                                      Style="{StaticResource SettingsSwitch}"
                                      IsChecked="{Binding IsCopilotInstructionsEnabled}"
                                      Content="{Binding NetworkProxyEnabledText, Source={x:Static l:Lang.Current}}" />
                        </Grid>
                        <StackPanel IsEnabled="{Binding IsCopilotInstructionsEnabled}">
                            <TextBlock Style="{StaticResource SettingsLabel}"
                                       Text="{Binding InstructionsPath, Source={x:Static l:Lang.Current}}" />
                            <TextBox x:Name="InstructionsPath" Style="{StaticResource SettingsInput}"
                                     input:TextBoxPlaceholder.Text="{Binding InstructionsPlaceholder, Source={x:Static l:Lang.Current}}"
                                     Text="{Binding CopilotInstructionsPath, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="32" Margin="0,6"
                                     ToolTip="{Binding InstructionsPlaceholder, Source={x:Static l:Lang.Current}}" />
                            <TextBlock Style="{StaticResource SettingsHint}"
                                       Text="{Binding InstructionsHint, Source={x:Static l:Lang.Current}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding ModelConfigurationTitle, Source={x:Static l:Lang.Current}}"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#17212B" Margin="0,0,0,16" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PrimaryModelLabel" Style="{StaticResource SettingsLabel}"
                                           Text="{Binding DefaultModelLabel, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PrimaryModelHint" Style="{StaticResource SettingsHint}" Margin="0,4,0,0"
                                           Text="{Binding DefaultModelHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox x:Name="PrimaryModelInput" Grid.Column="2" Style="{StaticResource SettingsInput}"
                                     Text="{Binding PrimaryModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" MinHeight="38"
                                     AutomationProperties.LabeledBy="{Binding ElementName=PrimaryModelLabel}"
                                     AutomationProperties.Name="{Binding DefaultModelLabel, Source={x:Static l:Lang.Current}}" />
                        </Grid>
                        <Expander x:Name="PurposeModelsExpander" Style="{StaticResource PurposeSection}" IsExpanded="False" HorizontalContentAlignment="Stretch" Margin="0,0,0,32">
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding PurposeModelsTitle, Source={x:Static l:Lang.Current}}" />
                                    <TextBlock Text="{Binding PurposeValidationFailed, Source={x:Static l:Lang.Current}}" Visibility="{Binding HasPurposeErrors, Converter={StaticResource PurposeVisibility}}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <ItemsControl x:Name="PurposeModelsList" DataContextChanged="OnPurposeListDataContextChanged" SizeChanged="OnPurposeListSizeChanged" MaxWidth="1000" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="PurposeRow" Loaded="OnPurposeRowLoaded" SizeChanged="OnPurposeRowSizeChanged" Padding="0,0,32,8">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName, StringFormat='{}{0}:'}" Visibility="{Binding IsBuiltIn, Converter={StaticResource PurposeVisibility}}" MinHeight="36" TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        <TextBox Height="36" Text="{Binding PurposeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"
                                                                 Visibility="{Binding CanEditPurpose, Converter={StaticResource PurposeVisibility}}"
                                                                 input:TextBoxPlaceholder.Text="{Binding PurposeKeyHint, Source={x:Static l:Lang.Current}}"
                                                                 AutomationProperties.Name="{Binding PurposeKeyLabel, Source={x:Static l:Lang.Current}}" />
                                                        <TextBlock Text="{Binding PurposeError}" Style="{StaticResource PurposeErrorText}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <ComboBox ItemsSource="{Binding ModelOptions}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="0" Height="36"
                                                                  AutomationProperties.Name="{Binding PurposeModelLabel, Source={x:Static l:Lang.Current}}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <TextBlock Text="{Binding ModelError}" Style="{StaticResource PurposeErrorText}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" VerticalAlignment="Top" Margin="6,0,0,0" Padding="4"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource PurposeVisibility}}"
                                                            Content="{Binding PurposeRemove, Source={x:Static l:Lang.Current}}"
                                                            Command="{Binding DataContext.RemovePurposeModelCommand, RelativeSource={RelativeSource AncestorType={x:Type views:SettingsView}}}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddPurposeModelButton" HorizontalAlignment="Left" Content="{Binding PurposeAdd, Source={x:Static l:Lang.Current}}" Command="{Binding AddPurposeModelCommand}" />
                            </StackPanel>
                        </Expander>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,0"><views:ModelSettingsView /></Border>
                    </StackPanel>
                </Border>
                <Border x:Name="CpaQuotaSettings" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding QuotaTitle, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{Binding QuotaAdd, Source={x:Static l:Lang.Current}}" Command="{Binding Quotas.AddServiceCommand}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Quotas.Services}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E4E9F0" BorderThickness="0,1,0,0" Padding="0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Width="32" Height="32" Padding="0" ToolTip="{Binding QuotaRemove, Source={x:Static l:Lang.Current}}" Command="{Binding DataContext.Quotas.RemoveServiceCommand, RelativeSource={RelativeSource AncestorType={x:Type views:SettingsView}}}" CommandParameter="{Binding}">
                                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><Path Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#50555C" StrokeThickness="1.5" Data="M1,1 L11,11 M11,1 L1,11"/></Border></ControlTemplate></Button.Template>
                                                </Button>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding QuotaAddress, Source={x:Static l:Lang.Current}}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Margin="12,0,0,0" Height="32" VerticalContentAlignment="Center" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding QuotaKey, Source={x:Static l:Lang.Current}}" VerticalAlignment="Center"/>
                                                <views:SecretInput Grid.Column="1" Margin="12,0,0,0" Text="{Binding ManagementKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding QuotaName, Source={x:Static l:Lang.Current}}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Margin="12,0,0,0" Height="32" VerticalContentAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding QuotaPrimary, Source={x:Static l:Lang.Current}}" IsChecked="{Binding IsPrimary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{Binding QuotaRefresh, Source={x:Static l:Lang.Current}}" Command="{Binding RefreshCommand}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Visibility="{Binding HasResults, Converter={StaticResource BooleanVisibility}}"/>
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource BooleanVisibility}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasResults, Converter={StaticResource BooleanVisibility}}">
                                                <TextBlock Text="{Binding QuotaObserved, Source={x:Static l:Lang.Current}}" Style="{StaticResource SettingsHint}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ObservedText}" Style="{StaticResource SettingsHint}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanVisibility}}">
            <TextBlock x:Name="SettingsStatus" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="28,12" />
        </Border>
    </Grid>
</UserControl>