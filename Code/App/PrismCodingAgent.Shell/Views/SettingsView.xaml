<UserControl x:Class="PrismCodingAgent.AvaloniaShell.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:l="clr-namespace:PrismCodingAgent.AvaloniaShell.Localizations" xmlns:v="clr-namespace:PrismCodingAgent.AvaloniaShell.Views" FontSize="12" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
 <UserControl.Resources>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="5,3"/><Setter Property="BorderBrush" Value="#CCD5DF"/></Style>
  <Style x:Key="SettingsHint" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#728091"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SettingsLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#344454"/></Style>
  <Style x:Key="SettingsInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/><TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}" Foreground="#777777" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Text" Value="{x:Null}"><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Background" Value="#CCCCCC"/><Setter TargetName="InputSurface" Property="BorderBrush" Value="#B8B8B8"/><Setter Property="Foreground" Value="#999999"/><Setter TargetName="Placeholder" Property="Foreground" Value="#999999"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource ComposerOption}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="Indicator" Width="20" Height="20" CornerRadius="3" BorderThickness="1" BorderBrush="#777777" VerticalAlignment="Center"><Path x:Name="Check" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 1,4 L 3,6 L 7,1" Stroke="White" StrokeThickness="1.5" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Indicator" Property="Background" Value="#F3F3F3"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Indicator" Property="Background" Value="#0078D7"/><Setter TargetName="Indicator" Property="BorderBrush" Value="#0078D7"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Indicator" Property="BorderBrush" Value="#17212B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Indicator" Property="Background" Value="#CCCCCC"/><Setter TargetName="Indicator" Property="BorderBrush" Value="#CCCCCC"/><Setter TargetName="Check" Property="Stroke" Value="#999999"/><Setter Property="Foreground" Value="#AAAAAA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsSwitch" TargetType="CheckBox">
   <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <StackPanel Orientation="Horizontal" Background="Transparent"><Border x:Name="SwitchTrack" Width="40" Height="20" CornerRadius="10" Background="White" BorderBrush="#777777" BorderThickness="1"><Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="#000000" HorizontalAlignment="Left" Margin="3,0"/></Border><TextBlock x:Name="SwitchText" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding NetworkProxyDisabledText, Source={x:Static l:Lang.Current}}"/></StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#0078D7"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#0078D7"/><Setter TargetName="SwitchKnob" Property="Fill" Value="White"/><Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchText" Property="Text" Value="{Binding NetworkProxyEnabledText, Source={x:Static l:Lang.Current}}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#17212B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EEEEEE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E5F1FB"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#888888"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,32,0" VerticalAlignment="Center"/><Path Data="M 0,0 L 5,5 L 10,0" Stroke="#333333" StrokeThickness="1.5" Width="10" Height="5" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/></Grid></Border><ToggleButton Focusable="False" Background="Transparent" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="0,4"><ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#F9F9F9"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#0078D7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E4E9F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,4"/></Style>
  <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
   <Setter Property="Width" Value="2"/><Setter Property="MinWidth" Value="2"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#8A8A8A" CornerRadius="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid Background="#F9F9F9">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#F9F9F9" BorderBrush="#E4E9F0" BorderThickness="0,0,0,1" Padding="32,24,32,16">
   <DockPanel>
    <Button x:Name="BackButton" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Padding="12,7" Margin="0,0,20,0" Content="{Binding BackArrowText, Source={x:Static l:Lang.Current}}" ToolTip="{Binding BackToChatText, Source={x:Static l:Lang.Current}}" Command="{Binding BackCommand}"/>
    <Button x:Name="SaveButton" DockPanel.Dock="Right" VerticalAlignment="Center" Height="38" FontSize="14" Padding="18,8" Content="{Binding SaveChangesText, Source={x:Static l:Lang.Current}}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Button.Style>
    </Button>
    <StackPanel><TextBlock Text="{Binding SettingsNavigationText, Source={x:Static l:Lang.Current}}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding SettingsSubtitle, Source={x:Static l:Lang.Current}}" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel>
   </DockPanel>
  </Border>
  <ProgressBar x:Name="SettingsProgress" Grid.Row="1" VerticalAlignment="Top" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" Panel.ZIndex="1"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}"/></ScrollViewer.Resources>
   <StackPanel Margin="32,8,32,32" MaxWidth="1120">
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <TextBlock Text="{Binding LanguageText, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <ComboBox x:Name="LanguageSelector" Width="104" Height="32" HorizontalAlignment="Left" ItemsSource="{Binding LanguageTags}" SelectedItem="{Binding LanguageTag, Mode=TwoWay}"/>
     <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding LanguageHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <TextBlock Text="{Binding DeepSeekApiKeyText, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <v:SecretInput x:Name="DeepSeekApiKeyInput" Height="32" Text="{Binding DeepSeekApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
     <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding DeepSeekApiKeyHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="10" Background="#E9F7F1" Margin="0,0,14,0"><TextBlock Text="&gt;_" FontSize="12" FontWeight="Bold" Foreground="#118565" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding SandboxTitle, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold" Foreground="#17212B"/><TextBlock Text="{Binding SandboxDescription, Source={x:Static l:Lang.Current}}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
      <CheckBox Grid.Column="2" x:Name="SandboxEnabled" Style="{StaticResource SettingsSwitch}" IsChecked="{Binding IsWindowsSandboxEnabled}" Content="{Binding NetworkProxyEnabledText, Source={x:Static l:Lang.Current}}"/>
     </Grid>
     <Border Background="#F0F9F6" BorderBrush="#CDE9DF" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="✓" FontWeight="Bold" Foreground="#118565" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{Binding SandboxTrustHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap" Foreground="#175F4D"/></Grid></Border>
     <Grid IsEnabled="{Binding IsWindowsSandboxEnabled}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding SandboxToolPath, Source={x:Static l:Lang.Current}}" FontSize="12" FontWeight="SemiBold" Foreground="#344454"/><TextBox x:Name="SandboxPath" Text="{Binding WindowsSandboxToolPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,6"/><TextBlock Style="{StaticResource SettingsHint}" Text="{Binding SandboxToolHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding SandboxAddress, Source={x:Static l:Lang.Current}}" FontSize="12" FontWeight="SemiBold" Foreground="#344454"/><TextBox x:Name="SandboxAddress" LostFocus="OnWindowsSandboxServerAddressLostFocus" Text="{Binding WindowsSandboxServerAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,6"/><TextBlock Style="{StaticResource SettingsHint}" Text="{Binding SandboxAddressHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"/></StackPanel>
     </Grid>
     <ProgressBar x:Name="SandboxProgress" IsIndeterminate="True" Height="4"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSandboxConnectionTestRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
     <TextBlock x:Name="SandboxStatus" Text="{Binding SandboxConnectionStatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger><DataTrigger Binding="{Binding IsSandboxConnectionStatusError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="10" Background="#EAF4FC" Margin="0,0,14,0"><TextBlock Text="NET" FontSize="11" FontWeight="Bold" Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding NetworkProxySettingsTitle, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold" Foreground="#17212B"/><TextBlock Text="{Binding NetworkProxySettingsDescription, Source={x:Static l:Lang.Current}}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel>
      <CheckBox Grid.Column="2" x:Name="ProxyEnabled" Style="{StaticResource SettingsSwitch}" IsChecked="{Binding IsNetworkProxyEnabled}"/>
     </Grid>
     <StackPanel IsEnabled="{Binding IsNetworkProxyEnabled}">
      <TextBlock Style="{StaticResource SettingsLabel}" Text="{Binding NetworkProxyAddressLabel, Source={x:Static l:Lang.Current}}"/>
      <TextBox x:Name="ProxyAddress" Style="{StaticResource SettingsInput}" Tag="{Binding NetworkProxyAddressPlaceholder, Source={x:Static l:Lang.Current}}" Text="{Binding NetworkProxyAddress, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,6"/>
      <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding NetworkProxyAddressHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"/>
      <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <CheckBox x:Name="ProxyBypass" IsChecked="{Binding BypassProxyOnLocal}" Content="{Binding BypassProxyOnLocalText, Source={x:Static l:Lang.Current}}"/>
       <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SettingsHint}" Text="{Binding BypassProxyOnLocalHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"/>
      </Grid>
     </StackPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="10" Background="#EAF4FC" Margin="0,0,14,0"><TextBlock Text="LSP" FontSize="10" FontWeight="Bold" Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding LanguageServerSettingsTitle, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding LanguageServerSettingsDescription, Source={x:Static l:Lang.Current}}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="InstallLanguageServerButton" Style="{StaticResource PrimaryButton}" Content="{Binding InstallOrUpdateLanguageServerText, Source={x:Static l:Lang.Current}}" Click="OnInstallOrUpdateLanguageServerClick" Margin="0,0,8,0"/>
       <Button x:Name="CopyLanguageServerCommandButton" Background="#EEEEEE" Content="{Binding CopyLanguageServerInstallCommandText, Source={x:Static l:Lang.Current}}" ToolTip="{Binding CopyLanguageServerInstallCommandToolTip, Source={x:Static l:Lang.Current}}" Click="OnCopyLanguageServerInstallCommandClick"/>
      </StackPanel>
     </Grid>
     <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding LanguageServerInstallHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"/>
     <TextBlock x:Name="LanguageServerStatus" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="10" Background="#EAF4FC" Margin="0,0,14,0"><TextBlock Text="MD" FontSize="11" FontWeight="Bold" Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding InstructionsTitle, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding InstructionsDescription, Source={x:Static l:Lang.Current}}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/></StackPanel>
      <CheckBox Grid.Column="2" x:Name="InstructionsEnabled" Style="{StaticResource SettingsSwitch}" IsChecked="{Binding IsCopilotInstructionsEnabled}" Content="{Binding NetworkProxyEnabledText, Source={x:Static l:Lang.Current}}"/>
     </Grid>
     <StackPanel IsEnabled="{Binding IsCopilotInstructionsEnabled}">
      <TextBlock Style="{StaticResource SettingsLabel}" Text="{Binding InstructionsPath, Source={x:Static l:Lang.Current}}"/>
      <TextBox x:Name="InstructionsPath" Style="{StaticResource SettingsInput}" Tag="{Binding InstructionsPlaceholder, Source={x:Static l:Lang.Current}}" Text="{Binding CopilotInstructionsPath, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,6" ToolTip="{Binding InstructionsPlaceholder, Source={x:Static l:Lang.Current}}"/>
      <TextBlock Style="{StaticResource SettingsHint}" Text="{Binding InstructionsHint, Source={x:Static l:Lang.Current}}" TextWrapping="Wrap"/>
     </StackPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource SettingsCard}"><StackPanel>
     <TextBlock Text="{Binding ModelConfigurationTitle, Source={x:Static l:Lang.Current}}" FontSize="15" FontWeight="SemiBold" Foreground="#17212B" Margin="0,0,0,16"/>
     <Grid Margin="0,0,0,16">
      <TextBox x:Name="PrimaryModelInput" Text="{Binding PrimaryModel, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Height="38" Padding="10,3" BorderBrush="#CCD5DF" AutomationProperties.Name="{Binding DefaultModelHint, Source={x:Static l:Lang.Current}}"/>
      <TextBlock Text="{Binding DefaultModelHint, Source={x:Static l:Lang.Current}}" FontSize="14" Foreground="#B8B8B8" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PrimaryModelInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <v:ModelSettingsView/>
    </StackPanel></Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanVisibility}}">
   <TextBlock x:Name="SettingsStatus" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="28,12"/>
  </Border>
 </Grid>
</UserControl>
