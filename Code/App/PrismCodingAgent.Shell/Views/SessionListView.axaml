<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localizations="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
             xmlns:arc="using:TKCode.Arc"
             xmlns:views="using:PrismCodingAgent.CodingShell.Views"
             xmlns:vm="clr-namespace:PrismCodingAgent.CodingShell.ViewModels"
             x:Class="PrismCodingAgent.CodingShell.Views.SessionListView"
             x:DataType="vm:SessionListViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16,0,16,16">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{Binding SessionListTitle, Source={x:Static localizations:Lang.Current}}" Classes="Title" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding OrganizeHistoryText, Source={x:Static localizations:Lang.Current}}"
                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OrganizeHistoryCommand}" />
                <Button Content="{Binding RefreshHistoryText, Source={x:Static localizations:Lang.Current}}" Command="{Binding ReloadCommand}" />
            </StackPanel>
        </Grid>
        <TextBox Grid.Row="1" PlaceholderText="{Binding HistorySearchText, Source={x:Static localizations:Lang.Current}}" Text="{Binding SearchText}" Margin="0,0,0,12" />
        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Text="{Binding HistoryLoadingText, Source={x:Static localizations:Lang.Current}}" IsVisible="{Binding IsLoading}" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).HistoryOrganizationResult}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="3">
            <TextBlock Text="{Binding EmptySessionListText, Source={x:Static localizations:Lang.Current}}" Classes="Subtitle"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmpty}" />
            <ListBox ItemsSource="{Binding Sessions}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionItemViewModel">
                        <Border Classes="Card" Padding="16,12" Margin="0,4" DoubleTapped="OnSessionDoubleTapped">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" IsVisible="{Binding !IsEditing}"
                                               ToolTip.Tip="{Binding Title}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsEditing}">
                                        <TextBox Text="{Binding EditedTitle}" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding SaveTitleText, Source={x:Static localizations:Lang.Current}}"
                                                Command="{Binding $parent[UserControl].DataContext.SaveTitleCommand}" CommandParameter="{Binding}" />
                                        <Button Grid.Column="2" Margin="8,0,0,0" Content="{Binding CancelEditText, Source={x:Static localizations:Lang.Current}}"
                                                Command="{Binding $parent[UserControl].DataContext.CancelEditCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                Margin="12,0,0,0" IsVisible="{Binding !IsEditing}">
                                        <Border IsVisible="{Binding IsCurrent}"
                                                Padding="10,4" CornerRadius="6" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource BackgroundBrush}">
                                            <TextBlock Text="{Binding CurrentSessionText, Source={x:Static localizations:Lang.Current}}" FontWeight="SemiBold" />
                                        </Border>
                                        <Button Classes="Flat" Width="32" Height="32" Padding="7"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding EditSessionTitleText, Source={x:Static localizations:Lang.Current}}"
                                                AutomationProperties.Name="{Binding EditSessionTitleText, Source={x:Static localizations:Lang.Current}}"
                                                Command="{Binding $parent[UserControl].DataContext.EditTitleCommand}"
                                                CommandParameter="{Binding}">
                                            <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Pencil}"
                                                          Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="Subtitle" TextTrimming="CharacterEllipsis">
                                            <ToolTip.Tip>
                                                <TextBlock><Run Text="{Binding WorkTaskText}" /><Run Text=" | " /><Run Text="{Binding Subtitle}" /></TextBlock>
                                            </ToolTip.Tip>
                                            <Run Text="{Binding WorkTaskText}" /><Run Text=" | " /><Run Text="{Binding Subtitle}" />
                                        </TextBlock>
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Text="{Binding SessionWorkspaceText, Source={x:Static localizations:Lang.Current}}" Classes="Subtitle" />
                                            <TextBlock Grid.Column="1" Text="{Binding WorkspacePath}" Classes="Subtitle"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding WorkspacePath}" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                        <Button Content="{Binding OpenSessionText, Source={x:Static localizations:Lang.Current}}"
                                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenSessionCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="Icon Danger" Width="32" Height="32" Padding="7"
                                                ToolTip.Tip="{Binding DeleteSessionText, Source={x:Static localizations:Lang.Current}}"
                                                AutomationProperties.Name="{Binding DeleteSessionText, Source={x:Static localizations:Lang.Current}}"
                                                Command="{Binding $parent[UserControl].DataContext.DeleteSessionCommand}" CommandParameter="{Binding}">
                                            <arc:ArcGlyph Size="16" Data="{x:Static arc:ArcIcons.Trash2}"
                                                          Foreground="{Binding $parent[Button].Foreground}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
