<Window x:Class="PrismCodingAgent.CodingShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:PrismCodingAgent.CodingShell.Localizations"
        xmlns:views="clr-namespace:PrismCodingAgent.CodingShell.Views"
        xmlns:converters="clr-namespace:PrismCodingAgent.CodingShell.Converters"
        Width="1440" Height="900" MinWidth="1280" MinHeight="720"
        Icon="Assets/Icons/CodingChatRoom.ico" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnExitKeyDown">
    <Window.Title>
        <MultiBinding Converter="{StaticResource WorkspaceTitleConverter}">
            <Binding Path="ChatViewModel.NextRunWorkspacePath" />
            <Binding Path="ChatViewModel.CurrentSessionTitle" />
            <Binding Path="ActiveWorkTask.DisplayName" />
            <Binding Path="ApplicationTitle" Source="{x:Static l:Lang.Current}" />
        </MultiBinding>
    </Window.Title>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" CanExecute="OnMessageCopyCanExecute"
                        Executed="OnMessageCopyExecuted" />
    </Window.CommandBindings>
    <Window.Resources>
        <converters:WindowWidthVisibilityConverter x:Key="WindowWidthVisibility" />
        <Style x:Key="TopModelSettings" TargetType="Grid">
            <Setter Property="Visibility" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowWidthVisibility}, ConverterParameter=1200}" />
        </Style>
        <ContextMenu x:Key="MessageMenu" x:Shared="False" MinWidth="104" FontFamily="Microsoft YaHei UI" Padding="0,4"
                     Background="#FAFAFA" BorderBrush="#D5D5D5" BorderThickness="1"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.ItemContainerStyle>
                <StaticResource ResourceKey="MessageMenuItem" />
            </ContextMenu.ItemContainerStyle>
            <MenuItem Header="{Binding CopyBody, Source={x:Static l:Lang.Current}}" Command="ApplicationCommands.Copy"
                      CommandParameter="{Binding Content}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="{Binding CopyMessage, Source={x:Static l:Lang.Current}}"
                      Command="ApplicationCommands.Copy" CommandParameter="{Binding FullContent}"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
        <DataTemplate x:Key="MessageText">
            <views:MessageTextBox FontFamily="Microsoft YaHei UI" FontSize="13"
                                  MessageText="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                  TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="2"
                                  MinHeight="0" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8"
                                  Visibility="{Binding HasText, Converter={StaticResource BooleanVisibility}}">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding CopyBody, Source={x:Static l:Lang.Current}}"
                                  Command="ApplicationCommands.Copy"
                                  CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </TextBox.ContextMenu>
            </views:MessageTextBox>
        </DataTemplate>
        <DataTemplate x:Key="MessageImage">
            <Button Margin="0,0,0,8" Padding="0" HorizontalAlignment="Left" Background="Transparent"
                    BorderThickness="0" Cursor="Hand" CommandParameter="{Binding}" Click="OnMessageImageClick">
                <views:BinaryImage Width="240" Height="180" Data="{Binding Data}" />
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="MessageReasoning">
            <Expander IsExpanded="False" Margin="0,0,0,8" HorizontalAlignment="Left" FontFamily="Microsoft YaHei UI"
                      FontSize="13" Visibility="{Binding HasText, Converter={StaticResource BooleanVisibility}}">
                <Expander.Header>
                    <TextBlock Text="{Binding ReasoningProcess, Source={x:Static l:Lang.Current}}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#546E7A" />
                </Expander.Header>
                <Expander.Template>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Height="48"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          HorizontalContentAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#CCFFFFFF" BorderBrush="#33000000" BorderThickness="1"
                                                CornerRadius="4">
                                            <DockPanel Margin="15,0,0,0">
                                                <Grid DockPanel.Dock="Right" Width="32" Height="32" Margin="20,0,8,0">
                                                    <Path x:Name="Chevron" Width="14" Height="7" Stretch="Fill"
                                                          Stroke="#333333" StrokeThickness="1" Data="M0,0 L5,5 L10,0"
                                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Grid>
                                                <ContentPresenter
                                                    Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                    VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Data" Value="M0,5 L5,0 L10,5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="ExpandSite" Visibility="Collapsed" Background="#F2F2F2"
                                    BorderBrush="#33000000" BorderThickness="1,0,1,1" Padding="16"
                                    CornerRadius="0,0,4,4">
                                <ContentPresenter ContentSource="Content" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Expander.Template>
                <Border Background="#F0F4F8" Padding="10,8" Margin="0,4" CornerRadius="4" BorderBrush="#90A4AE"
                        BorderThickness="3,0,0,0">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#546E7A" />
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="MessageTool">
            <Expander Margin="0,0,0,8" MinWidth="170" IsExpanded="False" HorizontalAlignment="Left"
                      HorizontalContentAlignment="Stretch" Template="{StaticResource ToolAgentExpanderTemplate}">
                <Expander.Header>
                    <Grid ToolTip="{Binding ToolTipText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding PrimaryText}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasPrimaryText, Converter={StaticResource BooleanVisibility}}" />
                        <TextBlock Grid.Column="2" Margin="8,0,0,0" MaxWidth="240" Text="{Binding SecondaryText}"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasSecondaryText, Converter={StaticResource BooleanVisibility}}" />
                    </Grid>
                </Expander.Header>
                <Border Background="#F5F5F5" BorderBrush="#BDBDBD" BorderThickness="1" Padding="8,6" Margin="0,4"
                        CornerRadius="6">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasInputText, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding ToolInputText, Source={x:Static l:Lang.Current}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding InputText}" TextWrapping="Wrap" Padding="2" Margin="0,0,0,6" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Details.MessageItems}"
                                      ItemTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                        <StackPanel Visibility="{Binding HasOutputText, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding ToolOutputText, Source={x:Static l:Lang.Current}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding OutputText}" TextWrapping="Wrap" Padding="2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="MessageSubAgent">
            <Expander Margin="0,0,0,8" IsExpanded="True" HorizontalAlignment="Left"
                      HorizontalContentAlignment="Stretch" Template="{StaticResource ToolAgentExpanderTemplate}">
                <Expander.Header>
                    <TextBlock Text="{Binding DisplayName}" />
                </Expander.Header>
                <Border Background="#E8EAF6" BorderBrush="#BDBDBD" BorderThickness="1" Padding="8,6" Margin="0,4"
                        CornerRadius="6">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasInputText, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding TaskInput, Source={x:Static l:Lang.Current}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding InputText}" TextWrapping="Wrap" Padding="2" Margin="0,0,0,6" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MessageItems}"
                                      ItemTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                        <StackPanel Visibility="{Binding HasOutputText, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding ParentAgentOutput, Source={x:Static l:Lang.Current}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding OutputText}" TextWrapping="Wrap" Padding="2" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="MessageApproval">
            <Border Background="#FFFFF3E0" BorderBrush="#BDBDBD" BorderThickness="1" Padding="8,6" CornerRadius="6"
                    Margin="0,0,0,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ApprovalStateText}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding HasApprovalDescription, Converter={StaticResource BooleanVisibility}}">
                        <TextBlock Text="{Binding ApprovalDescription, Source={x:Static l:Lang.Current}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding ApprovalDescription}" TextWrapping="Wrap" Padding="2" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding HasInputText, Converter={StaticResource BooleanVisibility}}">
                        <TextBlock Text="{Binding ToolInputText, Source={x:Static l:Lang.Current}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding InputText}" TextWrapping="Wrap" Padding="2" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding HasOutputText, Converter={StaticResource BooleanVisibility}}">
                        <TextBlock Text="{Binding ToolOutputText, Source={x:Static l:Lang.Current}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding OutputText}" TextWrapping="Wrap" Padding="2" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,6"
                                Visibility="{Binding HasDecisionReason, Converter={StaticResource BooleanVisibility}}">
                        <TextBlock Text="{Binding DecisionReason, Source={x:Static l:Lang.Current}}"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding DecisionReason}" TextWrapping="Wrap" Padding="2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CanRespondToApproval, Converter={StaticResource BooleanVisibility}}"
                                IsEnabled="{Binding CanRespondToApproval}">
                        <Button Style="{StaticResource PrimaryButton}" Background="#0078D4" Padding="12,5"
                                Content="{Binding ApproveText, Source={x:Static l:Lang.Current}}"
                                CommandParameter="{Binding}" Click="OnApproveToolClick" Margin="0,0,8,0" />
                        <Button Background="#33000000" Foreground="#C42B1C" Padding="12,5"
                                Content="{Binding RejectText, Source={x:Static l:Lang.Current}}"
                                CommandParameter="{Binding}" Click="OnRejectToolClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <views:ChatMessageItemTemplateSelector x:Key="MessageParts" ImageItemTemplate="{StaticResource MessageImage}"
                                               ApprovalToolItemTemplate="{StaticResource MessageApproval}"
                                               TextItemTemplate="{StaticResource MessageText}"
                                               ReasoningItemTemplate="{StaticResource MessageReasoning}"
                                               ToolItemTemplate="{StaticResource MessageTool}"
                                               SubAgentItemTemplate="{StaticResource MessageSubAgent}" />
        <DataTemplate x:Key="AssistantMessage">
            <StackPanel Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#E6EDFC" Margin="0,0,10,0">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#4969B8"
                              Data="M8,3 L8,1 L10,1 L10,3 L14,3 L14,1 L16,1 L16,3 L20,3 L20,7 L23,7 L23,9 L20,9 L20,15 L23,15 L23,17 L20,17 L20,21 L4,21 L4,17 L1,17 L1,15 L4,15 L4,9 L1,9 L1,7 L4,7 L4,3 Z M6,5 L6,19 L18,19 L18,5 Z M8,9 L10,9 L10,12 L8,12 Z M14,9 L16,9 L16,12 L14,12 Z M8,15 L16,15 L16,17 L8,17 Z" />
                    </Border>
                    <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Margin="10,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="Transparent" Padding="0,8" ContextMenu="{StaticResource MessageMenu}">
                    <ItemsControl ItemsSource="{Binding MessageItems}"
                                  ItemTemplateSelector="{StaticResource MessageParts}" />
                </Border>
                <Border HorizontalAlignment="Right" Margin="0,14,0,0" Padding="6,4"
                        Background="{StaticResource SurfaceVariantBrush}" CornerRadius="6"
                        Visibility="{Binding HasUsageDetails, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock FontFamily="Microsoft YaHei UI" FontSize="11" Text="{Binding UsageSummaryText}"
                               TextAlignment="Right" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="UserMessage">
            <StackPanel Margin="0,0,0,24" HorizontalAlignment="Right" MaxWidth="720">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,2">
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="Bold" />
                </StackPanel>
                <Border Background="#E6EDFC" BorderBrush="#E1E9F9" BorderThickness="1" Padding="12,8"
                        CornerRadius="12,12,4,12" ContextMenu="{StaticResource MessageMenu}">
                    <ItemsControl ItemsSource="{Binding MessageItems}"
                                  ItemTemplateSelector="{StaticResource MessageParts}" />
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SystemMessage">
            <Border Background="{StaticResource SurfaceBrush}" Padding="12" Margin="0,4,0,16" CornerRadius="8"
                    HorizontalAlignment="Center" MaxWidth="520" ContextMenu="{StaticResource MessageMenu}">
                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="NoticeMessage">
            <Border Padding="12,8" Margin="0,0,0,24" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#EEF2F7" />
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                    <Button x:Name="RetryChatButton" Background="#33000000"
                            Content="{Binding RetryChatText, Source={x:Static l:Lang.Current}}"
                            Command="{Binding RetryCommand}" CommandParameter="{Binding Notice}"
                            Visibility="{Binding HasContinuation, Converter={StaticResource BooleanVisibility}}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <views:ChatEntryTemplateSelector x:Key="MessageEntries" UserMessageTemplate="{StaticResource UserMessage}"
                                         AssistantMessageTemplate="{StaticResource AssistantMessage}"
                                         SystemMessageTemplate="{StaticResource SystemMessage}"
                                         NoticeTemplate="{StaticResource NoticeMessage}" />
    </Window.Resources>
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid x:Name="MainContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid x:Name="Sidebar" Margin="16,28,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="4,0,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border Background="#E1E9FC" CornerRadius="10" Width="36" Height="36">
                        <Image Width="26" Height="26" Source="Assets/Icons/CodingChatRoom_48x48.png" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="CodingChatRoom" FontSize="16" FontWeight="Bold" Foreground="#24334D" />
                        <TextBlock Text="{Binding ProductSubtitleText, Source={x:Static l:Lang.Current}}" FontSize="12"
                                   Foreground="#62738D" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <Button x:Name="NewTaskButton" Grid.Row="1" Height="40" Margin="0,0,0,12"
                        Style="{StaticResource ChatPrimaryButton}" Command="{Binding CreateWorkTaskCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="White" Margin="0,0,10,0"
                              Data="M11,3 L13,3 L13,11 L21,11 L21,13 L13,13 L13,21 L11,21 L11,13 L3,13 L3,11 L11,11 Z" />
                        <TextBlock Text="{Binding NewWorkTaskText, Source={x:Static l:Lang.Current}}" />
                    </StackPanel>
                </Button>
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <TextBox x:Name="TaskSearch" Height="32" Padding="40,3,10,3" BorderBrush="#8A000000"
                             Text="{Binding WorkTaskSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding WorkTaskSearchText, Source={x:Static l:Lang.Current}}" />
                    <TextBlock Margin="41,0,0,0" VerticalAlignment="Center" Foreground="#B8B8B8"
                               IsHitTestVisible="False"
                               Text="{Binding WorkTaskSearchText, Source={x:Static l:Lang.Current}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WorkTaskSearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Path Width="15" Height="15" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Stretch="Uniform" Fill="#65758B" IsHitTestVisible="False"
                          Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M10,5 A5,5 0 1 1 10,15 A5,5 0 1 1 10,5 M14,14 L21,21 L19.5,22.5 L12.5,15.5 Z" />
                </Grid>
                <TextBlock Grid.Row="3" Margin="6,2,6,12"
                           Text="{Binding WorkTaskListText, Source={x:Static l:Lang.Current}}" FontSize="12"
                           FontWeight="SemiBold" Foreground="#62738D" />
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="TaskItems" ItemsSource="{Binding FilteredWorkTasks}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" BorderThickness="1" Margin="0,0,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0A000000" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                                        <Setter Property="Background" Value="#0A3978D4" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#10000000" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsActive}" Value="True" />
                                                            <Condition Binding="{Binding IsWorking}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="#183978D4" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Button MinHeight="44" Padding="12,6" Margin="0,0,36,0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.ActivateWorkTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" /><ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            ToolTip="{Binding StatusText}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#10000000" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWorking}"
                                                                            Value="True">
                                                                        <Setter Property="Background" Value="#3978D4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Path Width="14" Height="14" Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Fill" Value="#64748B" />
                                                                    <Setter Property="Data"
                                                                            Value="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M11,7 L13,7 L13,12 L16.5,14 L15.5,15.7 L11,13 Z" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsWorking}"
                                                                                Value="True">
                                                                            <Setter Property="Fill" Value="White" />
                                                                            <Setter Property="Data"
                                                                                    Value="M13,2 L5,13 L11,13 L10,22 L19,10 L13,10 Z" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                               Text="{Binding DisplayName}" FontSize="14"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}" />

                                                </Grid>
                                            </Button>
                                            <Button x:Name="TaskMore" Width="32" Height="32" Padding="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="OnTaskMenuClick"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="{Binding MoreActionsText, Source={x:Static l:Lang.Current}}">
                                                <Path Width="16" Height="16" Stretch="Uniform" Fill="#64748B"
                                                      Data="M4,10 A2,2 0 1 0 4,14 A2,2 0 1 0 4,10 M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 M20,10 A2,2 0 1 0 20,14 A2,2 0 1 0 20,10" />
                                                <Button.ContextMenu>
                                                    <ContextMenu
                                                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                        Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                        Style="{StaticResource TaskMenu}">
                                                        <MenuItem Style="{StaticResource TaskMenuItem}"
                                                                  Header="{Binding PinWorkTaskText, Source={x:Static l:Lang.Current}}"
                                                                  Command="{Binding Tag.PinWorkTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <Path Width="16" Height="16" Stretch="Uniform"
                                                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                      Data="M7,2 L17,2 L17,4 L16,4 L16,10 L19,13 L19,15 L13,15 L13,22 L11,22 L11,15 L5,15 L5,13 L8,10 L8,4 L7,4 Z" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Style="{StaticResource TaskMenuItem}"
                                                                  Header="{Binding RenameWorkTaskText, Source={x:Static l:Lang.Current}}"
                                                                  Command="{Binding Tag.RenameWorkTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <Path Width="16" Height="16" Stretch="Uniform"
                                                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                      Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Style="{StaticResource TaskMenuItem}"
                                                                  Header="{Binding ArchiveWorkTaskText, Source={x:Static l:Lang.Current}}"
                                                                  Command="{Binding Tag.ArchiveWorkTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <Path Width="16" Height="16" Stretch="Uniform"
                                                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                      Data="M3,4 L21,4 L21,8 L20,8 L20,21 L4,21 L4,8 L3,8 Z M5,6 L19,6 L19,8 L5,8 Z M9,11 L15,11 L15,13 L9,13 Z" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Style="{StaticResource DangerTaskMenuItem}"
                                                                  Header="{Binding DeleteSessionText, Source={x:Static l:Lang.Current}}"
                                                                  Command="{Binding Tag.DeleteWorkTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <Path Width="16" Height="16" Stretch="Uniform"
                                                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                      Data="M8,3 L16,3 L17,5 L21,5 L21,7 L19,7 L18,21 L6,21 L5,7 L3,7 L3,5 L7,5 Z M8,7 L9,19 L15,19 L16,7 Z M10,9 L12,9 L12,17 L10,17 Z M14,9 L16,9 L16,17 L14,17 Z" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Border Background="{StaticResource SurfaceBrush}"
                                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanVisibility}}"
                                                    Padding="4,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskNameEditor" MinHeight="32"
                                                             Text="{Binding EditedDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{Binding RenameWorkTaskText, Source={x:Static l:Lang.Current}}" />
                                                    <Button x:Name="SaveTaskName" Grid.Column="1" Margin="4,0,0,0"
                                                            Padding="8,4"
                                                            Content="{Binding ConfirmTaskNameText, Source={x:Static l:Lang.Current}}"
                                                            Command="{Binding DataContext.SaveWorkTaskNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                            <Border Width="3" Height="20" CornerRadius="2"
                                                    Background="{StaticResource PrimaryBrush}"
                                                    HorizontalAlignment="Left" IsHitTestVisible="False"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BooleanVisibility}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding EmptyWorkTaskSearchText, Source={x:Static l:Lang.Current}}"
                                   Margin="14,18" Foreground="#718198" TextWrapping="Wrap"
                                   Visibility="{Binding IsWorkTaskSearchEmpty, Converter={StaticResource BooleanVisibility}}" />
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding HasFilteredArchivedWorkTasks, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="{Binding ArchivedSearchResultsText, Source={x:Static l:Lang.Current}}"
                                       Margin="10,0,10,6" FontSize="12" FontWeight="SemiBold" Foreground="#718198" />
                            <ItemsControl x:Name="ArchivedSearchItems"
                                          ItemsSource="{Binding FilteredArchivedWorkTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0,4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition /><ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="RestoreSearchTask" HorizontalContentAlignment="Stretch"
                                                    Padding="10,8"
                                                    Command="{Binding DataContext.RestoreWorkTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding RestoreWorkTaskText, Source={x:Static l:Lang.Current}}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayName}" />
                                            </Button>
                                            <Button x:Name="ArchivedSearchMenu" Grid.Column="1" Content="…"
                                                    Click="OnTaskMenuClick"
                                                    ToolTip="{Binding MoreActionsText, Source={x:Static l:Lang.Current}}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Style="{StaticResource TaskMenu}"
                                                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Style="{StaticResource TaskMenuItem}"
                                                                  Header="{Binding RestoreWorkTaskText, Source={x:Static l:Lang.Current}}"
                                                                  Command="{Binding PlacementTarget.Tag.RestoreWorkTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <Path Width="16" Height="16" Stretch="Uniform"
                                                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                      Data="M3,5 L21,5 L21,9 L20,9 L20,21 L4,21 L4,9 L3,9 Z M5,7 L19,7 L19,9 L5,9 Z M11,18 L13,18 L13,13 L16,16 L17.5,14.5 L12,9 L6.5,14.5 L8,16 L11,13 Z" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Style="{StaticResource DangerTaskMenuItem}"
                                                                  Header="{Binding DeleteSessionText, Source={x:Static l:Lang.Current}}"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteArchivedWorkTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <Path Width="16" Height="16" Stretch="Uniform"
                                                                      Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                                                                      Data="M8,3 L16,3 L17,5 L21,5 L21,7 L19,7 L18,21 L6,21 L5,7 L3,7 L3,5 L7,5 Z M8,7 L9,19 L15,19 L16,7 Z M10,9 L12,9 L12,17 L10,17 Z M14,9 L16,9 L16,17 L14,17 Z" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <Button.Tag>
                                                    <Binding Path="DataContext"
                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </Button.Tag>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="5">
                    <Border Height="1" Background="#E0E7F1" Margin="8,0,8,16" />
                    <Button x:Name="ArchiveButton" Style="{StaticResource NavigationButton}" IsEnabled="True"
                            Command="{Binding OpenArchiveCommand}"
                            ToolTip="{Binding ArchiveNavigationText, Source={x:Static l:Lang.Current}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Data="M3,4 L21,4 L21,8 L20,8 L20,21 L4,21 L4,8 L3,8 Z M5,6 L19,6 L19,8 L5,8 Z M9,11 L15,11 L15,13 L9,13 Z" />
                            <TextBlock Text="{Binding ArchiveNavigationText, Source={x:Static l:Lang.Current}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryButton" Style="{StaticResource NavigationButton}" IsEnabled="True"
                            Command="{Binding OpenHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 M11,6 L13,6 L13,12 L17,14 L16,16 L11,13 Z" />
                            <TextBlock Text="{Binding AllSessionsText, Source={x:Static l:Lang.Current}}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" IsEnabled="True"
                            Command="{Binding OpenSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,12,0" Stretch="Uniform"
                                  Fill="{StaticResource TextPrimaryBrush}"
                                  Data="M4,3 L6,3 L6,8 L9,8 L9,10 L6,10 L6,21 L4,21 L4,10 L1,10 L1,8 L4,8 Z M11,3 L13,3 L13,14 L16,14 L16,16 L13,16 L13,21 L11,21 L11,16 L8,16 L8,14 L11,14 Z M18,3 L20,3 L20,6 L23,6 L23,8 L20,8 L20,21 L18,21 L18,8 L15,8 L15,6 L18,6 Z" />
                            <TextBlock Text="{Binding SettingsNavigationText, Source={x:Static l:Lang.Current}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Border x:Name="ContentSurface" Grid.Column="1" Margin="0,8,8,8" CornerRadius="8"
                    Background="{StaticResource BackgroundBrush}" BorderBrush="#12000000" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Grid x:Name="HistoryConversation" Margin="24,24,24,16"
                          Visibility="{Binding IsChatOpen, Converter={StaticResource BooleanVisibility}}">
                        <Grid.Resources>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ChatComboBox}" />
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="1" Margin="8,-12,8,8" Padding="16,12" CornerRadius="8" Background="#B3FFFFFF"
                                BorderBrush="#10000000" BorderThickness="1">
                            <Grid x:Name="ConversationToolbar" DataContext="{Binding ChatViewModel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11" Margin="0,0,0,7"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding WorkDirectoryText, Source={x:Static l:Lang.Current}}" />
                                <Grid Grid.Column="1" Style="{StaticResource TopModelSettings}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="228" /><ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConversationStatus" FontSize="11" Margin="0,0,0,7"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           ToolTip="{Binding StatusText}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ModelStatusLabelConverter}">
                                            <Binding Path="StatusText" /><Binding Path="SelectedModel.DisplayName" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock x:Name="ReasoningEffortLabel" Grid.Column="1" FontSize="11" Margin="0,0,0,7"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding ReasoningEffortText, Source={x:Static l:Lang.Current}}" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,0,16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkspaceInput" Height="32" MinHeight="32" BorderBrush="#8A000000"
                                             Text="{Binding WorkspaceInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding WorkspaceStatusText}"
                                             AutomationProperties.Name="{Binding WorkspacePlaceholderText, Source={x:Static l:Lang.Current}}">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border CornerRadius="4" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" />
                                                        <TextBlock x:Name="Placeholder"
                                                                   Margin="{TemplateBinding Padding}"
                                                                   Text="{Binding WorkspacePlaceholderText, Source={x:Static l:Lang.Current}}"
                                                                   Foreground="#999999" IsHitTestVisible="False"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Placeholder" Property="Visibility"
                                                                Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChangingWorkspace}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button x:Name="ApplyWorkspaceButton" Grid.Column="1" Height="32" MinWidth="72"
                                            Margin="8,0,0,0" Style="{StaticResource ChatPrimaryButton}"
                                            Content="{Binding ApplyText, Source={x:Static l:Lang.Current}}"
                                            Command="{Binding ApplyWorkspaceCommand}"
                                            IsEnabled="{Binding CanApplyWorkspace}" />
                                </Grid>
                                <Grid Grid.Row="1" Grid.Column="1" Style="{StaticResource TopModelSettings}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="228" /><ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ModelSelector" Height="32"
                                          Margin="0,0,8,0" MinHeight="32" ItemsSource="{Binding AvailableModels}"
                                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{Binding SelectModel, Source={x:Static l:Lang.Current}}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                <ComboBox Grid.Column="1" x:Name="ReasoningEffortSelector" Height="32"
                                          MinHeight="32" Margin="0" ItemsSource="{Binding AvailableReasoningEfforts}"
                                          SelectedItem="{Binding SelectedReasoningEffort, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="{Binding ReasoningEffortToolTip, Source={x:Static l:Lang.Current}}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                                </Grid>
                                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button x:Name="TaskHistoryButton" Style="{StaticResource ShellSecondaryButton}"
                                            Width="32" Height="32" Padding="7"
                                            ToolTip="{Binding SessionListTitle, Source={x:Static l:Lang.Current}}"
                                            AutomationProperties.Name="{Binding SessionListTitle, Source={x:Static l:Lang.Current}}"
                                            Command="{Binding OpenTaskHistoryCommand}">
                                        <Path Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                                              Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,4 A8,8 0 1 1 12,20 A8,8 0 1 1 12,4 M11,6 L13,6 L13,12 L17,14 L16,16 L11,13 Z" />
                                    </Button>
                                    <Button x:Name="OpenLogDirectoryButton"
                                            Style="{StaticResource ShellSecondaryButton}" Width="32" Height="32"
                                            Padding="7" Margin="8,0,0,0"
                                            ToolTip="{Binding OpenLogDirectoryText, Source={x:Static l:Lang.Current}}"
                                            AutomationProperties.Name="{Binding OpenLogDirectoryText, Source={x:Static l:Lang.Current}}"
                                            Command="{Binding OpenLogDirectoryCommand}">
                                        <Path Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}"
                                              Data="M5,2 L15,2 L20,7 L20,22 L5,22 Z M15,4 L15,8 L19,8 Z M8,11 L17,11 L17,13 L8,13 Z M8,15 L17,15 L17,17 L8,17 Z M8,19 L14,19 L14,21 L8,21 Z" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="WelcomePanel" Grid.Row="2" DataContext="{Binding ChatViewModel}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                                    Visibility="{Binding ShowWelcome, Converter={StaticResource BooleanVisibility}}">
                            <Border Width="52" Height="52" CornerRadius="16" Background="#E6EDFC"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Path Width="26" Height="26" Stretch="Uniform" Fill="#4969B8"
                                      Data="M4,4 L20,4 L20,18 L13,18 L8,22 L8,18 L4,18 Z M6,6 L6,16 L10,16 L10,18 L12,16 L18,16 L18,6 Z" />
                            </Border>
                            <TextBlock Text="{Binding WelcomeTitleText, Source={x:Static l:Lang.Current}}"
                                       FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="0,0,0,16" />
                            <TextBlock Text="{Binding WelcomeDescriptionText, Source={x:Static l:Lang.Current}}"
                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />
                            <TextBlock Text="{Binding WelcomeExamplesText, Source={x:Static l:Lang.Current}}"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="2" DataContext="{Binding ChatViewModel}"
                                      DataContextChanged="OnChatDataContextChanged"
                                      ScrollChanged="OnMessagesScrollChanged" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowWelcome}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl x:Name="HistoryMessages" ItemsSource="{Binding Messages}"
                                          ItemTemplateSelector="{StaticResource MessageEntries}" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="3">
                            <views:ChatView x:Name="ChatComposer" DataContext="{Binding ChatViewModel}" />
                        </StackPanel>
                        <Grid x:Name="ChatOverlayLayer" Grid.Row="2" Grid.RowSpan="2">
                            <views:ChatSettingsView x:Name="ChatSettingsPanel" DataContext="{Binding ChatViewModel}"
                                                    Background="{StaticResource BackgroundBrush}"
                                                    Visibility="{Binding IsChatSettingsOpen, Converter={StaticResource BooleanVisibility}}" />
                        </Grid>
                    </Grid>
                    <views:ModelSetupView x:Name="ModelGuide" DataContext="{Binding SettingsViewModel}">
                        <views:ModelSetupView.Style>
                            <Style TargetType="views:ModelSetupView">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding DataContext.ChatViewModel.AvailableModels.Count, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ModelSetupView.Style>
                    </views:ModelSetupView>
                    <views:ArchivedWorkTasksView x:Name="ArchivePage"
                                                 Visibility="{Binding IsArchiveOpen, Converter={StaticResource BooleanVisibility}}" />
                    <views:SessionListView x:Name="HistoryPage"
                                           Visibility="{Binding IsHistoryOpen, Converter={StaticResource BooleanVisibility}}" />
                    <views:SettingsView DataContext="{Binding SettingsViewModel}"
                                        Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanVisibility}}" />
                </Grid>
            </Border>
            <Border Grid.ColumnSpan="2" Margin="20,8" Padding="12,8" VerticalAlignment="Top" Background="#FFF4CE"
                    BorderBrush="#D6B656" BorderThickness="1" CornerRadius="6"
                    Visibility="{Binding HasErrorMessage, Converter={StaticResource BooleanVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#5D4A00" />
            </Border>
        </Grid>
        <Border x:Name="ExitOverlay" Visibility="Collapsed" Background="#66000000"
                KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding ExitConfirmationTitle, Source={x:Static l:Lang.Current}}" FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ExitConfirmationDescription, Source={x:Static l:Lang.Current}}"
                               TextWrapping="Wrap" FontSize="13" LineHeight="18" Foreground="#62738D" Margin="0,16,0,0" />
                    <TextBlock x:Name="ExitProgress" Visibility="Collapsed"
                               Text="{Binding ExitCleanupProgress, Source={x:Static l:Lang.Current}}"
                               TextWrapping="Wrap" Margin="0,16,0,0" />
                    <TextBlock x:Name="ExitError" Visibility="Collapsed"
                               Text="{Binding ExitCleanupFailed, Source={x:Static l:Lang.Current}}"
                               Foreground="DarkRed" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="CancelExitButton" Background="#CCCCCC" Click="OnCancelExit"
                                Content="{Binding ExitCancelText, Source={x:Static l:Lang.Current}}" Padding="12,6"
                                Margin="0,0,12,0" />
                        <Button x:Name="ConfirmExitButton" Foreground="#F44336" Background="#CCCCCC"
                                Click="OnConfirmExit"
                                Content="{Binding ExitConfirmText, Source={x:Static l:Lang.Current}}" Padding="12,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>