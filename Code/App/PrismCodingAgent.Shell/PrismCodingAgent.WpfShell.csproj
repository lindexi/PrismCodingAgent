<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>PrismCodingAgent.CodingShell</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseUIFramework>Wpf</UseUIFramework>
    <DefineConstants>$(DefineConstants);USE_WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DotNetCampus.SourceLocalizations" Version="0.1.1-alpha.6" />
    <ProjectReference Include="..\..\Lib\AgentLib\AgentLib.Coding\AgentLib.Coding.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Icons/CodingChatRoom_48x48.png" />
    <Resource Include="Assets/Icons/CodingChatRoom.ico" />
    <Compile Remove="**/*.ava.cs" />
    <Compile Remove="**/*.axaml.cs" />
    <None Remove="**/*.axaml" />
    <Page Remove="**/*.axaml" />
    <ApplicationDefinition Remove="**/*.axaml" />
    <AvaloniaResource Remove="**/*.axaml" />
  </ItemGroup>
</Project>