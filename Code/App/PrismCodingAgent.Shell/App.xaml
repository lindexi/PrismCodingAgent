<Application x:Class="PrismCodingAgent.CodingShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PrismCodingAgent.CodingShell.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <ResourceDictionary Source="Styles/MessageBubble.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:ModelStatusLabelConverter x:Key="ModelStatusLabelConverter" />
            <converters:WorkspaceTitleConverter x:Key="WorkspaceTitleConverter" />
            <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F3F3F3" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
